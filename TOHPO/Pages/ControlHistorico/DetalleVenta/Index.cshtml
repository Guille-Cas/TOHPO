@page
@model TOHPO.Pages.ControlHistorico.DetalleVenta.IndexModel
@{
    ViewData["Title"] = "Histórico - Detalles de Ventas";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools">
                        <div class="btn-group">
                            <form method="post" asp-page-handler="ExportarExcel" class="d-inline">
                                <input type="hidden" asp-for="FechaInicio" />
                                <input type="hidden" asp-for="FechaFin" />
                                <input type="hidden" asp-for="BuscarProducto" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fas fa-file-excel"></i> Excel
                                </button>
                            </form>
                            <form method="post" asp-page-handler="ExportarPdf" class="d-inline">
                                <input type="hidden" asp-for="FechaInicio" />
                                <input type="hidden" asp-for="FechaFin" />
                                <input type="hidden" asp-for="BuscarProducto" />
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-file-pdf"></i> PDF
                                </button>
                            </form>
                        </div>
                        <a asp-page="../Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>

                <!-- Filtros de búsqueda -->
                <form method="post" asp-page-handler="Filtrar">
                    <div class="card-body border-bottom">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                                    <input asp-for="FechaInicio" class="form-control" type="date" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
                                    <input asp-for="FechaFin" class="form-control" type="date" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="BuscarProducto" class="form-label">Buscar Producto</label>
                                    <input asp-for="BuscarProducto" class="form-control" placeholder="Código o nombre del producto..." />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="form-label">&nbsp;</label>
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-search"></i> Filtrar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card-body">
                    @if (Model.DetalleVentas.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered" id="dataTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Fecha Venta</th>
                                        <th>Cliente</th>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio Unitario</th>
                                        <th>Descuento (%)</th>
                                        <th>Monto Descuento</th>
                                        <th>Monto Impuesto</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in Model.DetalleVentas)
                                    {
                                        <tr>
                                            <td>@detalle.Id</td>
                                            <td>@detalle.Venta?.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@detalle.Venta?.Cliente?.Nombre</td>
                                            <td>@detalle.Producto?.Descripcion (@detalle.Codigo_Producto)</td>
                                            <td class="text-end">@detalle.Cantidad.ToString("N0")</td>
                                            <td class="text-end">@detalle.Precio_Unitario.ToString("C2")</td>
                                            <td class="text-end">@detalle.Porcentaje_Descuento.ToString("N2")%</td>
                                            <td class="text-end">@detalle.Monto_Descuento.ToString("C2")</td>
                                            <td class="text-end">@detalle.Monto_Impuesto.ToString("C2")</td>
                                            <td class="text-end fw-bold">@detalle.Subtotal.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="8" class="text-end">Total General:</th>
                                        <th class="text-end">@Model.TotalImpuestos.ToString("C2")</th>
                                        <th class="text-end">@Model.TotalSubtotal.ToString("C2")</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            No se encontraron detalles de ventas con los criterios especificados.
                        </div>
                    }
                </div>

                <div class="card-footer">
                    <div class="row">
                        <div class="col-md-4">
                            <small class="text-muted">
                                <i class="fas fa-eye"></i> Vista de solo lectura - Total de registros: @Model.DetalleVentas.Count()
                            </small>
                        </div>
                        <div class="col-md-4 text-center">
                            <small class="text-muted">
                                <i class="fas fa-download"></i> Exportar datos: Use los botones Excel o PDF arriba
                            </small>
                        </div>
                        <div class="col-md-4 text-end">
                            <small class="text-muted">
                                Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json"
                },
                "responsive": true,
                "pageLength": 25,
                "order": [[0, "desc"]]
            });
        });
    </script>
}