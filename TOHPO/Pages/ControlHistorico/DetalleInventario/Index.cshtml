@page
@model TOHPO.Pages.ControlHistorico.DetalleInventario.IndexModel
@{
    ViewData["Title"] = "Histórico - Movimientos de Inventario";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools">
                        <div class="btn-group">
                            <form method="post" asp-page-handler="ExportarExcel" class="d-inline">
                                <input type="hidden" asp-for="FechaInicio" />
                                <input type="hidden" asp-for="FechaFin" />
                                <input type="hidden" asp-for="BuscarMotivo" />
                                <button type="submit" class="btn btn-success btn-sm">
                                    <i class="fas fa-file-excel"></i> Excel
                                </button>
                            </form>
                            <form method="post" asp-page-handler="ExportarPdf" class="d-inline">
                                <input type="hidden" asp-for="FechaInicio" />
                                <input type="hidden" asp-for="FechaFin" />
                                <input type="hidden" asp-for="BuscarMotivo" />
                                <button type="submit" class="btn btn-danger btn-sm">
                                    <i class="fas fa-file-pdf"></i> PDF
                                </button>
                            </form>
                            <form method="post" asp-page-handler="CrearMovimientosFaltantes" class="d-inline">
                                <button type="submit" class="btn btn-warning btn-sm" 
                                        onclick="return confirm('¿Generar movimientos de inventario faltantes para ventas y compras? Esto solo debe ejecutarse una vez.')"
                                        title="Generar movimientos faltantes de ventas y compras">
                                    <i class="fas fa-sync"></i> Generar Movimientos Faltantes
                                </button>
                            </form>
                        </div>
                        <a asp-page="../Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>

                <!-- Filtros de búsqueda -->
                <form method="post" asp-page-handler="Filtrar">
                    <div class="card-body border-bottom">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                                    <input asp-for="FechaInicio" class="form-control" type="date" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
                                    <input asp-for="FechaFin" class="form-control" type="date" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="BuscarMotivo" class="form-label">Buscar Motivo</label>
                                    <input asp-for="BuscarMotivo" class="form-control" placeholder="Motivo del movimiento..." />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="form-label">&nbsp;</label>
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary">
                                            <i class="bi bi-search"></i> Filtrar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card-body">
                    @if (Model.MovimientosInventario.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-striped table-bordered" id="dataTable">
                                <thead class="table-dark">
                                    <tr>
                                        <th>ID</th>
                                        <th>Fecha</th>
                                        <th>Producto</th>
                                        <th>Motivo</th>
                                        <th>Tipo Movimiento</th>
                                        <th>Cantidad</th>
                                        <th>Stock después del Movimiento</th>
                                        <th>Precio Venta</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var item in Model.MovimientosInventario)
                                    {
                                        var movimiento = item.Movimiento;
                                        <tr>
                                            <td>@movimiento.Id</td>
                                            <td>@movimiento.Fecha.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@movimiento.Inventario?.Producto?.Descripcion (@movimiento.Inventario?.Codigo_Producto)</td>
                                            <td>@movimiento.Motivo</td>
                                            <td>
                                                <span class="badge @(GetTipoMovimientoBadgeClass(movimiento.Motivo))">
                                                    @GetTipoMovimiento(movimiento.Motivo)
                                                </span>
                                            </td>
                                            <td class="text-end">
                                                <span class="@(movimiento.Cantidad > 0 ? "text-success" : "text-danger")">
                                                    @(movimiento.Cantidad > 0 ? "+" : "")@movimiento.Cantidad.ToString("N0")
                                                </span>
                                            </td>
                                            <td class="text-end">@item.StockDespuesDelMovimiento.ToString("N0")</td>
                                            <td class="text-end">@movimiento.Inventario?.Precio_Venta.ToString("C2")</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot class="table-light">
                                    <tr>
                                        <th colspan="5" class="text-end">Total Movimientos:</th>
                                        <th class="text-end">@Model.TotalMovimientos.ToString("N0")</th>
                                        <th colspan="2"></th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="alert alert-info">
                            <i class="bi bi-info-circle"></i>
                            No se encontraron movimientos de inventario con los criterios especificados.
                        </div>
                    }
                </div>

                <div class="card-footer">
                    <div class="row">
                        <div class="col-md-4">
                            <small class="text-muted">
                                <i class="fas fa-eye"></i> Vista de solo lectura - Total de registros: @Model.MovimientosInventario.Count()
                            </small>
                        </div>
                        <div class="col-md-4 text-center">
                            <small class="text-muted">
                                <i class="fas fa-download"></i> Exportar datos: Use los botones Excel o PDF arriba
                            </small>
                        </div>
                        <div class="col-md-4 text-end">
                            <small class="text-muted">
                                Última actualización: @DateTime.Now.ToString("dd/MM/yyyy HH:mm:ss")
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function () {
            $('#dataTable').DataTable({
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.24/i18n/Spanish.json"
                },
                "responsive": true,
                "pageLength": 25,
                "order": [[1, "desc"]]
            });
        });
    </script>
}

@functions {
    private string GetTipoMovimientoBadgeClass(string motivo)
    {
        var motivoLower = motivo?.ToLower() ?? "";
        
        if (motivoLower.Contains("venta") || motivoLower.Contains("salida") || motivoLower.Contains("producción"))
            return "bg-danger";
        else if (motivoLower.Contains("compra") || motivoLower.Contains("entrada") || motivoLower.Contains("ingreso"))
            return "bg-success";
        else if (motivoLower.Contains("ajuste") || motivoLower.Contains("corrección"))
            return "bg-warning text-dark";
        else
            return "bg-info";
    }

    private string GetTipoMovimiento(string motivo)
    {
        var motivoLower = motivo?.ToLower() ?? "";
        
        if (motivoLower.Contains("venta") || motivoLower.Contains("salida") || motivoLower.Contains("producción"))
            return "Salida";
        else if (motivoLower.Contains("compra") || motivoLower.Contains("entrada") || motivoLower.Contains("ingreso"))
            return "Entrada";
        else if (motivoLower.Contains("ajuste") || motivoLower.Contains("corrección"))
            return "Ajuste";
        else
            return "Otros";
    }
}