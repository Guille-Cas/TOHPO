@page
@model IndexModel
@{
    ViewData["Title"] = "Pagina de inicio";
}

<style>
    .menu-rect {
        min-height: 80vh;
        border-radius: 1rem;
        box-shadow: 0 2px 12px rgba(0,0,0,0.08);
        background: #fff;
        display: flex;
        flex-direction: column;
        align-items: center;
        padding: 2rem 1rem;
        margin-bottom: 1rem;
    }
    .menu-title {
        font-size: 1.7rem;
        font-weight: 600;
        margin-bottom: 2rem;
        color: #343a40;
        text-align: center;
    }
    .menu-buttons {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
    }
    .menu-info-placeholder {
        width: 100%;
        display: flex;
        flex-direction: column;
        gap: 1rem;
        align-items: center;
        justify-content: flex-start;
        padding-top: 2rem;
        color: #6c757d;
        font-size: 1.1rem;
    }
    .info-box {
        width: 90%;
        height: 80px;
        background: #e9ecef;
        border-radius: 0.5rem;
    }
    .main-title {
        font-size: 2.5rem;
        font-weight: bold;
        text-align: center;
        margin-top: 2rem;
        margin-bottom: 2rem;
        color: #0d6efd;
        letter-spacing: 0.1em;
    }
</style>

<div class="container-fluid">
    <div class="row">
        <div class="col-12 ">
            <div class="main-title">TOHPO
                <br />
                <h3>Tecnología Operativa con Herramientas de Producción Organizacional</h3>
            </div>
            
        </div>
    </div>
    <div class="row g-4">
        <!-- Administración -->
        <div class="col-12 col-md-3 d-flex">
            <div class="menu-rect flex-fill w-100">
                <div class="menu-title">Administración</div>
                <div class="menu-buttons">
                    <a class="btn btn-primary" asp-page="/Configuracion/Clientes/Index">Clientes</a>
                    <a class="btn btn-outline-primary" asp-page="/Configuracion/Categorias/Index">Categorías</a>
                    <a class="btn btn-outline-primary" asp-page="/Configuracion/Presentaciones/Index">Presentaciones</a>
                    <a class="btn btn-outline-primary" asp-page="/Configuracion/Materias_Prima/Index">Materias Primas</a>
                    <a class="btn btn-outline-primary" asp-page="/Configuracion/Impuestos/Index">Impuestos</a>
                    <a class="btn btn-outline-primary" asp-page="/Configuracion/Metodos_Pago/Index">Métodos de pago</a>
                    <a class="btn btn-outline-primary" asp-page="/Configuracion/Proveedores/Index">Proveedores</a>
                    <a class="btn btn-outline-primary" asp-page="/Configuracion/Agentes_ventas/Index">Agentes de Ventas</a>
                    <button class="btn btn-outline-primary">Configuración</button>
                    <button class="btn btn-outline-primary">Reportes</button>
                </div>
            </div>
        </div>
        <!-- Operaciones -->
        <div class="col-12 col-md-3 d-flex">
            <div class="menu-rect flex-fill w-100">
                <div class="menu-title">Operaciones</div>
                <div class="menu-buttons">
                    <button class="btn btn-outline-success">Venta</button>
                    <button class="btn btn-outline-success">Compra</button>
                    <button class="btn btn-outline-success">Producción</button>
                    <button class="btn btn-outline-success">Pedido</button>
                    <button class="btn btn-outline-success">Inventario</button>
                    <a class="btn btn-outline-primary" asp-page="/Recordatorios/Index">Recordatorio</a>
                    <button class="btn btn-outline-success">Pedido</button>
                </div>
            </div>
        </div>
        <!-- Pedidos -->
        <div class="col-12 col-md-3 d-flex">
            <div class="menu-rect flex-fill w-100">
                <div class="menu-title">Pedidos</div>
                <div class="menu-info-placeholder">
                    <div>Cuadro de información de pedidos</div>
                    <div class="info-box"></div>
                    <div class="info-box"></div>
                </div>
            </div>
        </div>
        <!-- Recordatorios -->
        <div class="col-12 col-md-3 d-flex">
            <div class="menu-rect flex-fill w-100">
                <div class="menu-title">Recordatorios</div>
                <div class="menu-info-placeholder">
                    <div>Cuadro de información de recordatorios</div>
                    <div class="info-box">
                        <a class="btn btn-outline-primary" asp-page="/Recordatorios/Index">Recordatorios</a>
                    </div>
                    <div class="info-box"></div>
                </div>
            </div>
        </div>
    </div>
</div>
