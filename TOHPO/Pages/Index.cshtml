@page
@model IndexModel
@{
    ViewData["Title"] = "Pagina de inicio";
}

<div class="container-fluid py-4">
    <div class="row">
        <div class="col-12">
            <div class="main-title text-center mb-3">
                <h3 class="fs-3 main-subtitle">
                   Menú Principal
                </h3>

            </div>
        </div>
    </div>

    <div class="row g-4">
        <!-- Administración -->
        <div class="col-12 col-md-3 d-flex">
            <div class="card bg-secondary mb-1 menu-card card flex-fill w-100 d-flex flex-column align-items-center py-4 px-3">
                <div class="menu-title h5 fw-semibold text-center mb-2">
                    Administración
                </div>
                <div class="text-center  main-subtitle mb-4">
                    sección administrativa
                </div>
                <div class="menu-buttons d-grid gap-2 w-100">
                    <a class="btn btn-primary" asp-page="/Configuracion/Clientes/Index">Clientes</a>
                    <a class="btn btn-primary" asp-page="/Configuracion/Categorias/Index">Categorías</a>
                    <a class="btn btn-primary" asp-page="/Configuracion/Presentaciones/Index">Presentaciones</a>
                    <a class="btn btn-primary" asp-page="/Configuracion/Materias_Prima/Index">Materias Primas</a>
                    <a class="btn btn-primary" asp-page="/Configuracion/Impuestos/Index">Impuestos</a>
                    <a class="btn btn-primary" asp-page="/Configuracion/Metodos_Pago/Index">Métodos de pago</a>
                    <a class="btn btn-primary" asp-page="/Operaciones/Productos/Index">Productos</a>
                    <a class="btn btn-primary" asp-page="/Configuracion/Proveedores/Index">Proveedores</a>
                    <a class="btn btn-primary" asp-page="/Configuracion/Agentes_ventas/Index">Agentes de Ventas</a>
                    <button class="btn btn-primary">Datos Maestros</button>
                    <button class="btn btn-primary">Configuración</button>
                    <button class="btn btn-primary">Reportes</button>
                </div>
            </div>
        </div>

        <!-- Operaciones -->
        <div class="col-12 col-md-3 d-flex">
            <div class="card bg-secondary mb-2 menu-card card flex-fill w-100 d-flex flex-column align-items-center py-4 px-3">
                <div class="menu-title h5 fw-semibold text-center mb-2">
                    Operaciones
                </div>
                <div class="text-center  main-subtitle mb-4">
                    sección operativa
                </div>
                <div class="menu-buttons d-grid gap-2 w-100">
                    <a class="btn btn-primary" asp-page="/Operaciones/Ventas/Index">Ventas</a>
                    <a class="btn btn-primary" asp-page="/Operaciones/Compras/Index">Compras</a>
                    <a class="btn btn-primary" asp-page="/Operaciones/Produccion/Index">Producción</a>
                    <button class="btn btn-primary">Pedidos</button>
                    <a class="btn btn-primary" asp-page="/Operaciones/Inventario/Index">Inventario</a>
                    <a class="btn btn-primary" asp-page="/Recordatorios/Index">Recordatorios</a>
                </div>
            </div>
        </div>

        <!-- Pedidos -->
        <div class="col-12 col-md-3 d-flex">
            <div class="card bg-secondary mb-2 menu-card card flex-fill w-100 d-flex flex-column align-items-center py-4 px-3">
                <div class="menu-title h5 fw-semibold text-center mb-">
                    Pedidos
                </div>
                <div class="text-center  main-subtitle mb-3">
                    sección administrativa
                </div>
                <div class="menu-info-placeholder d-flex flex-column gap-3 align-items-center w-100 pt-2 text-secondary">
           
                    <div class="info-box bg-light rounded-3 w-100"></div>
                    <div class="info-box bg-light rounded-3 w-100"></div>
                </div>
            </div>
        </div>

        <!-- Recordatorios -->
        <div class="col-12 col-md-3 d-flex">
            <div class="card bg-secondary mb-5 menu-card card flex-fill w-100 d-flex flex-column align-items-center py-4 px-3">
                <div class="menu-title h5 fw-semibold text-center mb-2">
                    Recordatorios
                </div>
                <div class="text-center  main-subtitle mb-3">
                    sección administrativa
                </div>
                <div class="menu-info-placeholder d-flex flex-column gap-3 align-items-center w-100 pt-2 text-secondary">
           
                    <div class="info-box bg-light rounded-3 w-100 d-flex align-items-center justify-content-center">
                        
                    </div>
                    <div class="info-box bg-light rounded-3 w-100"></div>
                </div>
            </div>
        </div>
    </div>
</div>
