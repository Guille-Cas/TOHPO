@page "{id:int?}"
@model TOHPO.Pages.Operaciones.Pedidos.UpsertModel
@{
    ViewData["Title"] = Model.Pedido.Id == 0 ? "Crear Pedido" : "Editar Pedido";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">@ViewData["Title"]</h3>
                    <div class="card-tools">
                        <a asp-page="./Index" class="btn btn-secondary btn-sm">
                            Volver
                        </a>
                    </div>
                </div>

                <form method="post" id="pedidoForm">
                    <div class="card-body">
                        @if (!ViewData.ModelState.IsValid)
                        {
                            <div class="alert alert-danger">
                                <ul class="mb-0">
                                    @foreach (var error in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                                    {
                                        <li>@error.ErrorMessage</li>
                                    }
                                </ul>
                            </div>
                        }

                        <input type="hidden" asp-for="Pedido.Id" />

                        <!-- Información básica del pedido -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Pedido.Id_Cliente" class="form-label">Cliente *</label>
                                    <select asp-for="Pedido.Id_Cliente" asp-items="Model.ClientesList" 
                                            class="form-control" required>
                                        <option value="">Seleccione un cliente</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Pedido.Fecha_Creacion" class="form-label">Fecha de Creación *</label>
                                    <input asp-for="Pedido.Fecha_Creacion" class="form-control" type="datetime-local" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Pedido.Fecha_Entrega" class="form-label">Fecha de Entrega *</label>
                                    <input asp-for="Pedido.Fecha_Entrega" class="form-control" type="datetime-local" required />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Pedido.Abono" class="form-label">Abono</label>
                                    <input asp-for="Pedido.Abono" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                            </div>
                        </div>

                        <!-- Sección de agregar productos -->
                        <div class="card mb-4">
                            <div class="card-header bg-success text-white">
                                <h5 class="card-title mb-0">
                                    Agregar Productos
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="form-label">Buscar Producto</label>
                                            <div class="input-group">
                                                <input type="text" id="inputBuscarProducto" class="form-control" placeholder="Hacer clic en Seleccionar para elegir producto..." readonly />
                                                <button type="button" class="btn btn-outline-primary" id="btnSeleccionarProducto" data-bs-toggle="modal" data-bs-target="#modalSeleccionarProducto">
                                                    Seleccionar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">Cantidad</label>
                                            <input type="number" id="inputCantidad" class="form-control" value="1" min="1" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">Precio Unit.</label>
                                            <input type="number" id="inputPrecioUnitario" class="form-control" step="0.01" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">&nbsp;</label>
                                            <div class="d-grid">
                                                <button type="button" class="btn btn-success" id="btnAgregarProducto">
                                                    Agregar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Lista de productos -->
                        <div class="card mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="card-title mb-0">
                                    Productos del Pedido
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped mb-0" id="productosTable">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Producto</th>
                                                <th>Cant.</th>
                                                <th>Precio Unit.</th>
                                                <th>Subtotal</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="productosBody">
                                            <!-- Los productos se agregan dinámicamente aquí -->
                                        </tbody>
                                    </table>
                                </div>
                                <div id="emptyProductsMessage" class="text-center py-4">
                                    <h5 class="text-muted">No hay productos agregados</h5>
                                    <p class="text-muted">Comience agregando productos usando el buscador de arriba</p>
                                </div>
                            </div>
                        </div>

                        <!-- Totales -->
                        <div class="row">
                            <div class="col-md-8"></div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">Resumen del Pedido</h5>
                                        <div class="d-flex justify-content-between">
                                            <span>Total:</span>
                                            <span id="totalDisplay">₡0,00</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Abono:</span>
                                            <span id="abonoDisplay">₡@Model.Pedido.Abono.ToString("F2").Replace(".", ",")</span>
                                        </div>
                                        <hr>
                                        <div class="d-flex justify-content-between">
                                            <strong>Saldo:</strong>
                                            <strong class="text-primary fs-4" id="saldoDisplay">₡0,00</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Campos ocultos para los detalles -->
                        <div id="hiddenFields"></div>
                    </div>

                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-12 text-end">
                                <button type="submit" class="btn btn-primary btn-lg me-2" id="guardarBtn">
                                    @(Model.Pedido.Id == 0 ? "Crear Pedido" : "Actualizar Pedido")
                                </button>
                                <a asp-page="./Index" class="btn btn-secondary">
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal para seleccionar producto -->
<div class="modal fade" id="modalSeleccionarProducto" tabindex="-1" aria-labelledby="modalSeleccionarProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalSeleccionarProductoLabel">Seleccionar Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-6">
                        <div class="input-group">
                            <input type="text" id="filtroProducto" class="form-control" placeholder="Filtrar por nombre o código..." />
                            <button type="button" class="btn btn-outline-secondary" id="btnLimpiarFiltro">
                                Limpiar
                            </button>
                        </div>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-hover" id="tablaProductosModal">
                        <thead class="table-dark">
                            <tr>
                                <th>Nombre</th>
                                <th>Código</th>
                                <th>Cantidad en Inventario</th>
                                <th>Precio Unitario</th>
                                <th width="100">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="bodyProductosModal">
                            <!-- Los productos se cargan dinámicamente -->
                        </tbody>
                    </table>
                </div>
                <div id="noProductsMessage" class="text-center py-4" style="display: none;">
                    <h6 class="text-muted">No se encontraron productos</h6>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Variables globales
        let productos = @Html.Raw(Json.Serialize(Model.DetallesPedido));
        let productosDisponibles = @Html.Raw(Json.Serialize(Model.ProductosDisponibles));
        let contadorProductos = productos.length;

        // Función para formatear números decimales con coma
        function formatDecimal(value) {
            return parseFloat(value).toFixed(2).replace('.', ',');
        }

        function parseDecimal(value) {
            if (typeof value === 'string') {
                value = value.replace(',', '.');
            }
            return parseFloat(value) || 0;
        }

        // Objeto para manejar las funciones de pedidos
        const PedidoManager = {
            // Variables para el modal de productos
            productosModalData: [],
            
            // Función para cargar productos en el modal
            cargarProductosModal: function() {
                // Obtener datos de productos con información de inventario
                $.get('/Operaciones/Pedidos/Upsert?handler=ProductosInventario')
                    .done(function(data) {
                        if (data.success) {
                            PedidoManager.productosModalData = data.productos;
                            PedidoManager.mostrarProductosModal(PedidoManager.productosModalData);
                        } else {
                            alert('Error al cargar productos: ' + data.message);
                        }
                    })
                    .fail(function() {
                        alert('Error al conectar con el servidor');
                    });
            },

            // Función para mostrar productos en el modal
            mostrarProductosModal: function(productos) {
                const tbody = $('#bodyProductosModal');
                tbody.empty();

                if (productos.length === 0) {
                    $('#noProductsMessage').show();
                    return;
                }

                $('#noProductsMessage').hide();

                productos.forEach((producto, index) => {
                    const row = `
                        <tr>
                            <td>
                                <strong>${producto.nombre}</strong>
                                <br><small class="text-muted">${producto.descripcion || ''}</small>
                            </td>
                            <td>${producto.codigo}</td>
                            <td>
                                <span class="badge ${producto.cantidadInventario > 0 ? 'bg-success' : 'bg-warning'}">
                                    ${producto.cantidadInventario} unidades
                                </span>
                            </td>
                            <td>₡${parseFloat(producto.precio || 0).toFixed(2)}</td>
                            <td>
                                <button type="button" class="btn btn-primary btn-sm" 
                                        onclick="PedidoManager.seleccionarProducto('${producto.codigo}', '${producto.nombre}', ${producto.precio || 0})"
                                        data-bs-dismiss="modal">
                                    Seleccionar
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            },

            // Función para seleccionar un producto del modal
            seleccionarProducto: function(codigo, nombre, precio) {
                $('#inputBuscarProducto').val(`${codigo} - ${nombre}`).data('codigo', codigo);
                $('#inputPrecioUnitario').val(precio);
                $('#inputCantidad').focus();
            },

            // Función para filtrar productos en el modal
            filtrarProductos: function() {
                const filtro = $('#filtroProducto').val().toLowerCase();
                
                if (!filtro) {
                    this.mostrarProductosModal(this.productosModalData);
                    return;
                }

                const productosFiltrados = this.productosModalData.filter(producto => 
                    producto.nombre.toLowerCase().includes(filtro) || 
                    producto.codigo.toLowerCase().includes(filtro) ||
                    (producto.descripcion && producto.descripcion.toLowerCase().includes(filtro))
                );

                this.mostrarProductosModal(productosFiltrados);
            },

            // Función para buscar productos
            buscarProducto: function() {
                const busqueda = $('#inputBuscarProducto').val().toLowerCase();
                
                if (!busqueda) {
                    alert('Ingrese un código o nombre de producto');
                    return;
                }

                // Buscar por código
                let producto = productosDisponibles.find(p => p.codigo.toLowerCase() === busqueda);
                
                // Si no encuentra por código, buscar por nombre
                if (!producto) {
                    producto = productosDisponibles.find(p => p.descripcion.toLowerCase().includes(busqueda));
                }

                if (producto) {
                    $('#inputPrecioUnitario').val(producto.precio.toFixed(2));
                    $('#inputBuscarProducto').val(`${producto.codigo} - ${producto.descripcion}`).data('codigo', producto.codigo);
                    $('#inputCantidad').focus();
                } else {
                    alert('Producto no encontrado en el catálogo');
                    $('#inputBuscarProducto').focus();
                }
            },

            // Función para agregar productos
            agregarProducto: function() {
                const codigoBusqueda = $('#inputBuscarProducto').data('codigo') || $('#inputBuscarProducto').val().split(' - ')[0];
                const cantidad = parseInt($('#inputCantidad').val()) || 1;
                const precioUnitario = parseFloat($('#inputPrecioUnitario').val()) || 0;

                if (!codigoBusqueda) {
                    alert('Seleccione un producto válido');
                    return;
                }

                if (precioUnitario <= 0) {
                    alert('El precio unitario debe ser mayor a 0');
                    $('#inputPrecioUnitario').focus();
                    return;
                }

                const producto = productosDisponibles.find(p => p.codigo === codigoBusqueda);
                if (!producto) {
                    alert('Producto no válido');
                    return;
                }

                // Verificar stock disponible
                if (cantidad > producto.existencia) {
                    alert(`Stock insuficiente. Disponible: ${producto.existencia}`);
                    return;
                }

                // Verificar si el producto ya está en la lista
                const existeIndex = productos.findIndex(p => p.codigo_Producto === producto.codigo);
                
                if (existeIndex >= 0) {
                    // Actualizar cantidad del producto existente
                    productos[existeIndex].cantidad += cantidad;
                    productos[existeIndex].precio_Unitario = precioUnitario;
                } else {
                    // Agregar nuevo producto
                    productos.push({
                        codigo_Producto: producto.codigo,
                        producto_Descripcion: producto.descripcion,
                        cantidad: cantidad,
                        precio_Unitario: precioUnitario
                    });
                }

                // Limpiar campos
                $('#inputBuscarProducto').val('').removeData('codigo');
                $('#inputCantidad').val(1);
                $('#inputPrecioUnitario').val('');

                this.actualizarVistaProductos();
                this.calcularTotales();
                $('#inputBuscarProducto').focus();
            },

            // Función para eliminar productos
            eliminarProducto: function(index) {
                if (confirm('¿Está seguro de eliminar este producto?')) {
                    productos.splice(index, 1);
                    this.actualizarVistaProductos();
                    this.calcularTotales();
                }
            },

            // Función para editar cantidad
            editarCantidad: function(index, nuevaCantidad) {
                if (nuevaCantidad > 0) {
                    productos[index].cantidad = parseInt(nuevaCantidad);
                    this.calcularTotales();
                }
            },

            // Función para editar precio
            editarPrecio: function(index, nuevoPrecio) {
                if (nuevoPrecio > 0) {
                    productos[index].precio_Unitario = parseFloat(nuevoPrecio);
                    this.calcularTotales();
                }
            },

            // Función para actualizar vista de productos
            actualizarVistaProductos: function() {
                const tbody = $('#productosBody');
                tbody.empty();

                if (productos.length === 0) {
                    $('#emptyProductsMessage').show();
                    return;
                }

                $('#emptyProductsMessage').hide();

                productos.forEach((producto, index) => {
                    const subtotal = producto.cantidad * producto.precio_Unitario;
                    const row = `
                        <tr>
                            <td>
                                <strong>${producto.producto_Descripcion}</strong><br>
                                <small class="text-muted">${producto.codigo_Producto}</small>
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" 
                                       value="${producto.cantidad}" min="1"
                                       onchange="PedidoManager.editarCantidad(${index}, this.value)" />
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" 
                                       value="${producto.precio_Unitario.toFixed(2)}" min="0" step="0.01"
                                       onchange="PedidoManager.editarPrecio(${index}, this.value)" />
                            </td>
                            <td><strong>₡${formatDecimal(subtotal)}</strong></td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm" 
                                        onclick="PedidoManager.eliminarProducto(${index})" title="Eliminar">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });

                this.actualizarCamposOcultos();
            },

            // Función para calcular totales
            calcularTotales: function() {
                let total = 0;

                productos.forEach(producto => {
                    total += producto.cantidad * producto.precio_Unitario;
                });

                // Actualizar displays
                $('#totalDisplay').text(`₡${formatDecimal(total)}`);
                
                let abono = parseDecimal(document.querySelector('input[name="Pedido.Abono"]').value || '0');
                let saldo = total - abono;
                
                $('#saldoDisplay').text(`₡${formatDecimal(saldo)}`);

                // Actualizar vista de productos
                this.actualizarVistaProductos();
            },

            // Función para actualizar campos ocultos
            actualizarCamposOcultos: function() {
                const container = $('#hiddenFields');
                container.empty();

                productos.forEach((producto, index) => {
                    container.append(`
                        <input type="hidden" name="DetallesPedido[${index}].Codigo_Producto" value="${producto.codigo_Producto}" />
                        <input type="hidden" name="DetallesPedido[${index}].Producto_Descripcion" value="${producto.producto_Descripcion}" />
                        <input type="hidden" name="DetallesPedido[${index}].Cantidad" value="${producto.cantidad}" />
                        <input type="hidden" name="DetallesPedido[${index}].Precio_Unitario" value="${producto.precio_Unitario}" />
                    `);
                });
            }
        };

        // Inicialización cuando el documento está listo
        $(document).ready(function() {
            PedidoManager.actualizarVistaProductos();
            PedidoManager.calcularTotales();

            // Event listeners
            $('#btnBuscarProducto').on('click', function() {
                PedidoManager.buscarProducto();
            });

            $('#btnAgregarProducto').on('click', function() {
                PedidoManager.agregarProducto();
            });

            // Configurar búsqueda de productos con Enter
            $('#inputBuscarProducto').on('keypress', function(e) {
                if (e.which == 13) {
                    PedidoManager.buscarProducto();
                    return false;
                }
            });

            // Configurar Enter para agregar producto
            $('#inputCantidad, #inputPrecioUnitario').on('keypress', function(e) {
                if (e.which == 13) {
                    PedidoManager.agregarProducto();
                    return false;
                }
            });

            // Actualizar saldo cuando cambie el abono
            $('input[name="Pedido.Abono"]').on('change', function() {
                let abono = parseDecimal(this.value);
                $('#abonoDisplay').text(`₡${formatDecimal(abono)}`);
                PedidoManager.calcularTotales();
            });

            // Event listeners para el modal
            $('#modalSeleccionarProducto').on('show.bs.modal', function() {
                PedidoManager.cargarProductosModal();
            });

            $('#filtroProducto').on('input', function() {
                PedidoManager.filtrarProductos();
            });

            $('#btnLimpiarFiltro').on('click', function() {
                $('#filtroProducto').val('');
                PedidoManager.mostrarProductosModal(PedidoManager.productosModalData);
            });
        });
    </script>
}