@page
@model TOHPO.Pages.Operaciones.Pedidos.IndexModel
@{
    ViewData["Title"] = "Gestión de Pedidos";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools">
                        <a asp-page="./Upsert" class="btn btn-success btn-sm">
                            Nuevo Pedido
                        </a>
                    </div>
                </div>

                <!-- Filtros -->
                <form method="post" asp-page-handler="Filtrar">
                    <div class="card-body border-bottom">
                        <div class="row">
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                                    <input asp-for="FechaInicio" class="form-control" type="date" />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
                                    <input asp-for="FechaFin" class="form-control" type="date" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="BuscarCliente" class="form-label">Buscar Cliente</label>
                                    <input asp-for="BuscarCliente" class="form-control" placeholder="Nombre del cliente..." />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label asp-for="EstadoFiltro" class="form-label">Estado</label>
                                    <select asp-for="EstadoFiltro" class="form-control">
                                        <option value="">Todos</option>
                                        <option value="false">Pendiente</option>
                                        <option value="true">Completado</option>
                                    </select>
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="form-label">&nbsp;</label>
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary">
                                            Filtrar
                                        </button>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-1">
                                <div class="form-group">
                                    <label class="form-label">&nbsp;</label>
                                    <div class="d-grid">
                                        <a href="@Url.Page("Index")" class="btn btn-secondary">
                                            Actualizar
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="pedidosTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Fecha Creación</th>
                                    <th>Fecha Entrega</th>
                                    <th>Cliente</th>
                                    <th>Items</th>
                                    <th>Total</th>
                                    <th>Abono</th>
                                    <th>Saldo</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Pedidos?.Any() == true)
                                {
                                    @foreach (var pedido in Model.Pedidos)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary">#@(pedido.Id)</span>
                                            </td>
                                            <td>@(pedido.Fecha_Creacion.ToString("dd/MM/yyyy"))</td>
                                            <td>@(pedido.Fecha_Entrega.ToString("dd/MM/yyyy"))</td>
                                            <td>
                                                @if (pedido.Cliente != null)
                                                {
                                                    @($"{pedido.Cliente.Nombre ?? ""} {pedido.Cliente.Primer_Apellido ?? ""}")
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Cliente no disponible</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @(pedido.Pedido_Detalles?.Sum(d => d.Cantidad) ?? 0)
                                                </span>
                                            </td>
                                            <td>₡@(pedido.Total.ToString("N2"))</td>
                                            <td>₡@(pedido.Abono.ToString("N2"))</td>
                                            <td>₡@(pedido.Saldo.ToString("N2"))</td>
                                            <td>
                                                @if (pedido.Estado)
                                                {
                                                    <span class="badge bg-success">Completado</span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                                }
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <!-- Ver detalles -->
                                                    <button type="button" class="btn btn-info btn-sm" 
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#detalleModal@(pedido.Id)">
                                                        Detalles
                                                    </button>
                                                    
                                                    <!-- Editar -->
                                                    <a asp-page="./Upsert" asp-route-id="@pedido.Id" 
                                                       class="btn btn-warning btn-sm">
                                                        Editar
                                                    </a>
                                                    
                                                    <!-- MEJORA: Cambiar estado con botón dinámico -->
                                                    @if (pedido.Estado)
                                                    {
                                                        <!-- Pedido completado - opción para marcar como pendiente -->
                                                        <a asp-page-handler="ToggleEstado" asp-route-id="@pedido.Id" 
                                                           class="btn btn-outline-secondary btn-sm"
                                                           onclick="return confirm('¿Desea marcar este pedido como pendiente nuevamente?')"
                                                           title="Marcar como pendiente">
                                                            Reabrir
                                                        </a>
                                                    }
                                                    else
                                                    {
                                                        <!-- Pedido pendiente - opción para completar -->
                                                        <a asp-page-handler="ToggleEstado" asp-route-id="@pedido.Id" 
                                                           class="btn btn-success btn-sm"
                                                           onclick="return confirm('¿Confirma que desea completar este pedido?')"
                                                           title="Marcar como completado">
                                                            Completar
                                                        </a>
                                                    }
                                                    
                                                    <!-- Eliminar - solo para pedidos pendientes -->
                                                    @if (!pedido.Estado)
                                                    {
                                                        <a asp-page-handler="Eliminar" asp-route-id="@pedido.Id" 
                                                           class="btn btn-danger btn-sm"
                                                           onclick="return confirm('¿Está seguro de eliminar este pedido? Esta acción no se puede deshacer.')"
                                                           title="Eliminar pedido">
                                                            Eliminar
                                                        </a>
                                                    }
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="10" class="text-center text-muted">
                                            No se encontraron pedidos
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modales de detalle -->
@if (Model.Pedidos?.Any() == true)
{
    @foreach (var pedido in Model.Pedidos)
    {
        <div class="modal fade" id="detalleModal@(pedido.Id)" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">Detalle del Pedido #@pedido.Id</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Cliente:</strong> @pedido.Cliente.Nombre @pedido.Cliente.Primer_Apellido @pedido.Cliente.Segundo_Apellido
                            </div>
                            <div class="col-6">
                                <strong>Estado:</strong> 
                                @if (pedido.Estado)
                                {
                                    <span class="badge bg-success">Completado</span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark">Pendiente</span>
                                }
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-6">
                                <strong>Fecha Creación:</strong> @pedido.Fecha_Creacion.ToString("dd/MM/yyyy")
                            </div>
                            <div class="col-6">
                                <strong>Fecha Entrega:</strong> @pedido.Fecha_Entrega.ToString("dd/MM/yyyy")
                            </div>
                        </div>
                        
                        <h6>Productos:</h6>
                        <div class="table-responsive">
                            <table class="table table-sm">
                                <thead>
                                    <tr>
                                        <th>Producto</th>
                                        <th>Cantidad</th>
                                        <th>Precio Unit.</th>
                                        <th>Subtotal</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var detalle in pedido.Pedido_Detalles)
                                    {
                                        <tr>
                                            <td>@detalle.Producto.Descripcion</td>
                                            <td>@detalle.Cantidad</td>
                                            <td>₡@detalle.Precio_Unitario.ToString("N2")</td>
                                            <td>₡@((detalle.Cantidad * detalle.Precio_Unitario).ToString("N2"))</td>
                                        </tr>
                                    }
                                </tbody>
                                <tfoot>
                                    <tr class="table-dark">
                                        <th colspan="3">Total</th>
                                        <th>₡@pedido.Total.ToString("N2")</th>
                                    </tr>
                                </tfoot>
                            </table>
                        </div>
                        
                        <div class="row mt-3">
                            <div class="col-4">
                                <strong>Total:</strong> ₡@pedido.Total.ToString("N2")
                            </div>
                            <div class="col-4">
                                <strong>Abono:</strong> ₡@pedido.Abono.ToString("N2")
                            </div>
                            <div class="col-4">
                                <strong>Saldo:</strong> ₡@pedido.Saldo.ToString("N2")
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    </div>
                </div>
            </div>
        </div>
    }
}

@section Scripts {
    <script>
        $(document).ready(function() {
            try {
                // Verificar si hay datos en la tabla
                var table = $('#pedidosTable');
                var hasData = table.find('tbody tr').length > 0 && 
                             !table.find('tbody tr').first().find('td[colspan]').length;
                
                if (hasData) {
                    $('#pedidosTable').DataTable({
                        "language": {
                            "url": "//cdn.datatables.net/plug-ins/1.13.4/i18n/es-ES.json"
                        },
                        "order": [[ 0, "desc" ]],
                        "pageLength": 25,
                        "responsive": true,
                        "columnDefs": [
                            { "orderable": false, "targets": 9 } // Columna de acciones no ordenable
                        ]
                    });
                } else {
                    console.log('No hay datos para inicializar DataTables');
                }
            } catch (error) {
                console.error('Error inicializando DataTables:', error);
            }
        });
    </script>
}