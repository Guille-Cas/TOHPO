@page
@model TOHPO.Pages.Operaciones.Produccion.IndexModel
@{
    ViewData["Title"] = "Gestión de Producción";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3> Gestión de Producción</h3>
                </div>
                <div class="card-body">
                    <!-- Mensajes -->
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }
                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <!-- Pestañas -->
                    <ul class="nav nav-tabs" id="produccionTabs" role="tablist">
                        <li class="nav-item" role="presentation">
                            <button class="nav-link active" id="recetas-tab" data-bs-toggle="tab" data-bs-target="#recetas" type="button" role="tab">
                                Recetas
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="nueva-produccion-tab" data-bs-toggle="tab" data-bs-target="#nueva-produccion" type="button" role="tab">
                                Nueva Producción
                            </button>
                        </li>
                        <li class="nav-item" role="presentation">
                            <button class="nav-link" id="producciones-tab" data-bs-toggle="tab" data-bs-target="#producciones" type="button" role="tab">
                               Producciones
                            </button>
                        </li>
                    </ul>

                    <div class="tab-content" id="produccionTabsContent">
                        <!-- Tab Recetas -->
                        <div class="tab-pane fade show active" id="recetas" role="tabpanel">
                            <div class="mt-3">
                                <div class="row mb-3">
                                    <div class="col-md-8">
                                        <form method="post" asp-page-handler="Filtrar">
                                            <div class="input-group">
                                                <input type="text" class="form-control" asp-for="BuscarReceta" placeholder="Buscar receta o producto...">
                                                <button class="btn btn-outline-secondary" type="submit">
                                                     Buscar
                                                </button>
                                            </div>
                                        </form>
                                    </div>
                                    <div class="col-md-4 text-end">
                                        <a asp-page="Upsert" class="btn btn-primary">
                                             Nueva Receta
                                        </a>
                                    </div>
                                </div>

                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Descripción</th>
                                                <th>Producto</th>
                                                <th>Rendimiento</th>
                                                <th>Cantidad Empaque</th>
                                                <th>Fecha Creación</th>
                                                <th>Estado</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Recetas?.Any() == true)
                                            {
                                                @foreach (var receta in Model.Recetas)
                                                {
                                                    <tr>
                                                        <td>@receta.Descripcion</td>
                                                        <td>@receta.Producto?.Descripcion</td>
                                                        <td>@receta.Rendimiento.ToString("N2")</td>
                                                        <td>@receta.Cantidad_Empaque.ToString("N2")</td>
                                                        <td>@receta.Fecha_Creacion.ToString("dd/MM/yyyy")</td>
                                                        <td>
                                                            <span class="badge @(receta.Estado ? "bg-success" : "bg-danger")">
                                                                @(receta.Estado ? "Activo" : "Inactivo")
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <div class="btn-group btn-group-sm" role="group">
                                                                <button type="button" class="btn btn-info" onclick="verDetalleReceta(@receta.Id)">
                                                                    Detalles
                                                                </button>
                                                                <a asp-page="Upsert" asp-route-id="@receta.Id" class="btn btn-warning">
                                                                    Editar
                                                                </a>
                                                                <a asp-page-handler="EliminarReceta" asp-route-id="@receta.Id" 
                                                                   class="btn btn-danger" 
                                                                   onclick="return confirm('¿Está seguro de eliminar esta receta?')">
                                                                    Eliminar
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="7" class="text-center">No se encontraron recetas</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Tab Nueva Producción -->
                        <div class="tab-pane fade" id="nueva-produccion" role="tabpanel">
                            <div class="mt-3">
                                <form method="post" asp-page-handler="GenerarProduccion">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="RecetaIdProduccion" class="form-label">Receta *</label>
                                                <select asp-for="RecetaIdProduccion" class="form-select" required>
                                                    <option value="">Seleccione una receta...</option>
                                                    @if (Model.Recetas?.Any() == true)
                                                    {
                                                        @foreach (var receta in Model.Recetas)
                                                        {
                                                            <option value="@receta.Id">@receta.Descripcion - @receta.Producto?.Descripcion</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="CantidadProducir" class="form-label">Cantidad a Producir *</label>
                                                <input asp-for="CantidadProducir" type="number" step="0.01" min="0.01" class="form-control" required>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="ObraProduccion" class="form-label">Obra</label>
                                                <input asp-for="ObraProduccion" type="text" class="form-control" maxlength="100">
                                            </div>
                                        </div>
                                        <div class="col-md-6">
                                            <div class="mb-3">
                                                <label asp-for="FechaPlaneada" class="form-label">Fecha Planeada *</label>
                                                <input asp-for="FechaPlaneada" type="date" class="form-control" required>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="mb-3">
                                        <label asp-for="DescripcionProduccion" class="form-label">Descripción</label>
                                        <textarea asp-for="DescripcionProduccion" class="form-control" rows="3" maxlength="500"></textarea>
                                    </div>
                                    <div class="text-end">
                                        <button type="submit" class="btn btn-success">
                                           Generar Producción
                                        </button>
                                    </div>
                                </form>
                            </div>
                        </div>

                        <!-- Tab Producciones -->
                        <div class="tab-pane fade" id="producciones" role="tabpanel">
                            <div class="mt-3">
                                <form method="post" asp-page-handler="Filtrar" class="mb-3">
                                    <div class="row">
                                        <div class="col-md-4">
                                            <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                                            <input asp-for="FechaInicio" type="date" class="form-control">
                                        </div>
                                        <div class="col-md-4">
                                            <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
                                            <input asp-for="FechaFin" type="date" class="form-control">
                                        </div>
                                        <div class="col-md-4 d-flex align-items-end">
                                            <button type="submit" class="btn btn-outline-secondary">
                                                 Filtrar
                                            </button>
                                        </div>
                                    </div>
                                </form>

                                <div class="table-responsive">
                                    <table class="table table-striped table-hover">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>ID</th>
                                                <th>Fecha</th>
                                                <th>Obra</th>
                                                <th>Descripción</th>
                                                <th>Fecha Planeada</th>
                                                <th>Estado</th>
                                                <th>Progreso</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @if (Model.Producciones?.Any() == true)
                                            {
                                                @foreach (var produccion in Model.Producciones)
                                                {
                                                    var detallesCompletos = produccion.Produccion_Detalles?.Count(pd => !pd.Estado) ?? 0;
                                                    var totalDetalles = produccion.Produccion_Detalles?.Count() ?? 0;
                                                    var progreso = totalDetalles > 0 ? (detallesCompletos * 100 / totalDetalles) : 0;
                                                    
                                                    <tr>
                                                        <td>@produccion.Id</td>
                                                        <td>@produccion.Fecha.ToString("dd/MM/yyyy")</td>
                                                        <td>@produccion.Obra</td>
                                                        <td>@produccion.Descripcion</td>
                                                        <td>@produccion.Fecha_Planeada.ToString("dd/MM/yyyy")</td>
                                                        <td>
                                                            <span class="badge @(produccion.Estado ? "bg-success" : "bg-secondary")">
                                                                @(produccion.Estado ? "En Progreso" : "Finalizada")
                                                            </span>
                                                        </td>
                                                        <td>
                                                            <div class="progress" style="height: 20px;">
                                                                <div class="progress-bar @(progreso == 100 ? "bg-success" : "bg-primary")" 
                                                                     role="progressbar" 
                                                                     style="width: @progreso%"
                                                                     aria-valuenow="@progreso" 
                                                                     aria-valuemin="0" 
                                                                     aria-valuemax="100">
                                                                    @progreso%
                                                                </div>
                                                            </div>
                                                        </td>
                                                        <td>
                                                            <div class="btn-group btn-group-sm" role="group">
                                                                <button type="button" class="btn btn-info" onclick="verDetalleProduccion(@produccion.Id)">
                                                                    Detalles
                                                                </button>
                                                                @if (produccion.Estado)
                                                                {
                                                                    <a asp-page-handler="FinalizarProduccion" asp-route-id="@produccion.Id" 
                                                                       class="btn btn-success"
                                                                       onclick="return confirm('¿Está seguro de finalizar esta producción? Esto generará movimientos de inventario.')">
                                                                        Finalizar
                                                                    </a>
                                                                }
                                                                <a asp-page-handler="CambiarEstadoProduccion" asp-route-id="@produccion.Id" 
                                                                   class="btn @(produccion.Estado ? "btn-warning" : "btn-success")"
                                                                   onclick="return confirm('¿Está seguro de cambiar el estado?')">
                                                                   Cambiar estado
                                                                </a>
                                                            </div>
                                                        </td>
                                                    </tr>
                                                }
                                            }
                                            else
                                            {
                                                <tr>
                                                    <td colspan="8" class="text-center">No se encontraron producciones</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para detalle de receta -->
<div class="modal fade" id="detalleRecetaModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle de Receta</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contenidoDetalleReceta">
                <!-- Contenido se carga dinámicamente -->
            </div>
        </div>
    </div>
</div>

<!-- NUEVO: Modal para detalle de producción -->
<div class="modal fade" id="detalleProduccionModal" tabindex="-1">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Detalle de Producción</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contenidoDetalleProduccion">
                <!-- Contenido se carga dinámicamente -->
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function verDetalleReceta(id) {
            fetch(`?handler=DetalleReceta&id=${id}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const receta = data.receta;
                        document.getElementById('contenidoDetalleReceta').innerHTML = `
                            <div class="row">
                                <div class="col-md-6">
                                    <p><strong>Descripción:</strong> ${receta.descripcion}</p>
                                    <p><strong>Producto:</strong> ${receta.producto}</p>
                                    <p><strong>Rendimiento:</strong> ${receta.rendimiento}</p>
                                    <p><strong>Cantidad Empaque:</strong> ${receta.cantidadEmpaque}</p>
                                    <p><strong>Fecha Creación:</strong> ${receta.fechaCreacion}</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Detalle:</strong></p>
                                    <p class="text-muted">${receta.detalle || 'Sin detalle'}</p>
                                </div>
                                <div class="col-12">
                                    <p><strong>Instrucciones:</strong></p>
                                    <div class="card card-body bg-light">
                                        ${receta.instrucciones}
                                    </div>
                                </div>
                            </div>
                        `;
                        new bootstrap.Modal(document.getElementById('detalleRecetaModal')).show();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al cargar el detalle de la receta');
                });
        }

        // NUEVO: Función para ver detalle de producción
        function verDetalleProduccion(id) {
            fetch(`?handler=DetalleProduccion&id=${id}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const produccion = data.produccion;
                        let detallesHtml = '';
                        
                        if (produccion.detalles && produccion.detalles.length > 0) {
                            detallesHtml = produccion.detalles.map(detalle => `
                                <tr>
                                    <td>${detalle.receta}</td>
                                    <td>${detalle.producto}</td>
                                    <td>${detalle.cantidadProgramada}</td>
                                    <td>${detalle.cantidadProducida}</td>
                                    <td>${detalle.fechaInicio || 'No iniciado'}</td>
                                    <td>${detalle.fechaFin || 'En progreso'}</td>
                                    <td><span class="badge ${ detalle.estado ? 'bg-warning' : 'bg-success'}">${detalle.estado ? 'En Progreso' : 'Terminado'}</span></td>
                                </tr>
                            `).join('');
                        } else {
                            detallesHtml = '<tr><td colspan="7" class="text-center">No hay detalles de producción</td></tr>';
                        }

                        document.getElementById('contenidoDetalleProduccion').innerHTML = `
                            <div class="row mb-3">
                                <div class="col-md-6">
                                    <p><strong>ID:</strong> ${produccion.id}</p>
                                    <p><strong>Fecha:</strong> ${produccion.fecha}</p>
                                    <p><strong>Obra:</strong> ${produccion.obra || 'Sin especificar'}</p>
                                </div>
                                <div class="col-md-6">
                                    <p><strong>Descripción:</strong> ${produccion.descripcion}</p>
                                    <p><strong>Fecha Planeada:</strong> ${produccion.fechaPlaneada}</p>
                                    <p><strong>Estado:</strong> <span class="badge ${produccion.estado ? 'bg-success' : 'bg-secondary'}">${produccion.estado ? 'En Progreso' : 'Finalizada'}</span></p>
                                </div>
                            </div>
                            <div class="table-responsive">
                                <table class="table table-striped">
                                    <thead class="table-dark">
                                        <tr>
                                            <th>Receta</th>
                                            <th>Producto</th>
                                            <th>Cantidad Programada</th>
                                            <th>Cantidad Producida</th>
                                            <th>Fecha Inicio</th>
                                            <th>Fecha Fin</th>
                                            <th>Estado</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        ${detallesHtml}
                                    </tbody>
                                </table>
                            </div>
                        `;
                        new bootstrap.Modal(document.getElementById('detalleProduccionModal')).show();
                    } else {
                        alert('Error: ' + data.message);
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    alert('Error al cargar el detalle de la producción');
                });
        }
    </script>
}