@page
@model TOHPO.Pages.Operaciones.Produccion.UpsertModel
@{
    ViewData["Title"] = Model.Receta.Id == 0 ? "Nueva Receta" : "Editar Receta";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools">
                        <a asp-page="./Index" class="btn btn-light btn-sm">
                            Volver al Listado
                        </a>
                    </div>
                </div>

                <form method="post" id="recetaForm">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <input type="hidden" asp-for="Receta.Id" />

                        <!-- Información básica de la receta -->
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Receta.Descripcion" class="form-label">Descripción de la Receta</label>
                                    <input asp-for="Receta.Descripcion" class="form-control" placeholder="Nombre de la receta..." />
                                    <span asp-validation-for="Receta.Descripcion" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Receta.Codigo_Producto" class="form-label">Producto Final</label>
                                    <select asp-for="Receta.Codigo_Producto" asp-items="Model.ProductosList" class="form-select">
                                        <option value="">-- Seleccionar Producto --</option>
                                    </select>
                                    <span asp-validation-for="Receta.Codigo_Producto" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Receta.Rendimiento" class="form-label">Rendimiento (Unidades Producidas)</label>
                                    <input asp-for="Receta.Rendimiento" class="form-control" type="number" step="0.01" min="0.01" />
                                    <span asp-validation-for="Receta.Rendimiento" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Receta.Cantidad_Empaque" class="form-label">Cantidad por Empaque (Opcional)</label>
                                    <input asp-for="Receta.Cantidad_Empaque" class="form-control" type="number" step="0.01" min="0" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="Receta.Estado" class="form-label">Estado</label>
                                    <select asp-for="Receta.Estado" class="form-select">
                                        <option value="true">Activa</option>
                                        <option value="false">Inactiva</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Receta.Instrucciones" class="form-label">Instrucciones de Preparación</label>
                                    <textarea asp-for="Receta.Instrucciones" class="form-control" rows="4" placeholder="Pasos para preparar la receta..."></textarea>
                                    <span asp-validation-for="Receta.Instrucciones" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Receta.Detalle" class="form-label">Detalles Adicionales (Opcional)</label>
                                    <textarea asp-for="Receta.Detalle" class="form-control" rows="4" placeholder="Información adicional sobre la receta..."></textarea>
                                </div>
                            </div>
                        </div>

                        <!-- Sección de agregar materias primas -->
                        <div class="card mb-4">
                            <div class="card-header bg-success text-white">
                                <h5 class="card-title mb-0">
                                    <i class="fas fa-plus"></i> Agregar Materias Primas
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-8">
                                        <div class="form-group">
                                            <label class="form-label">Materia Prima</label>
                                            <div class="input-group">
                                                <input type="text" id="inputBuscarMateriaPrima" class="form-control form-control-lg bg-light" 
                                                       placeholder="Seleccione una materia prima usando el botón..." 
                                                       data-id="" data-unidad-medida=""
                                                       style="font-size: 1.1rem; cursor: pointer;" 
                                                       readonly 
                                                       title="Haga clic en 'Seleccionar' para elegir una materia prima" />
                                                <button type="button" class="btn btn-outline-primary" id="btnSeleccionarMateriaPrima" data-bs-toggle="modal" data-bs-target="#modalSeleccionarMateriaPrima">
                                                    <i class="fas fa-search"></i> Seleccionar
                                                </button>
                                            </div>
                                            <small class="form-text text-muted">
                                                <i class="fas fa-info-circle"></i> Use el botón "Seleccionar" para elegir una materia prima de la lista
                                            </small>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">Cantidad</label>
                                            <input type="number" id="inputCantidad" class="form-control" 
                                                   step="0.001" min="0.001" value="1" placeholder="0.000" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">&nbsp;</label>
                                            <div class="d-grid">
                                                <button type="button" class="btn btn-success" id="btnAgregarMateriaPrima">
                                                    <i class="fas fa-plus"></i> Agregar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-group">
                                            <label class="form-label">Observaciones (Opcional)</label>
                                            <input type="text" id="inputObservaciones" class="form-control" 
                                                   placeholder="Notas adicionales sobre esta materia prima..." />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Tabla de materias primas agregadas -->
                        <div class="card mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="card-title mb-0">
                                    <i class="fas fa-list"></i> Materias Primas de la Receta
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="table-responsive">
                                    <table class="table table-striped" id="tablaMateriasPrimas">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Materia Prima</th>
                                                <th>Cantidad</th>
                                                <th>Unidad</th>
                                                <th>Observaciones</th>
                                                <th width="100">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cuerpoTablaMateriasPrimas">
                                            <tr id="filaVaciaReceta">
                                                <td colspan="5" class="text-center text-muted">
                                                    No se han agregado materias primas. Use el buscador arriba para agregar.
                                                </td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>

                        <!-- Campos ocultos para los detalles -->
                        <div id="hiddenFieldsMateriasPrimas"></div>
                    </div>

                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-12 text-end">
                                <button type="submit" class="btn btn-success btn-lg me-2" id="guardarBtn">
                                    @(Model.Receta.Id == 0 ? "Crear Receta" : "Actualizar Receta")
                                </button>
                                <a asp-page="./Index" class="btn btn-secondary">
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Selección de Materias Primas -->
<div class="modal fade" id="modalSeleccionarMateriaPrima" tabindex="-1" aria-labelledby="modalSeleccionarMateriaPrimaLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalSeleccionarMateriaPrimaLabel">
                    <i class="fas fa-search"></i> Seleccionar Materia Prima
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <input type="text" id="filtroMateriaPrima" class="form-control" 
                               placeholder="Buscar materia prima por nombre..."
                               autofocus>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100" onclick="RecetaManager.filtrarMateriasPrimas()">
                            <i class="fas fa-search"></i> Filtrar
                        </button>
                    </div>
                </div>
                
                <div class="table-responsive" style="max-height: 400px; overflow-y: auto;">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th>Descripción</th>
                                <th>Unidad de Medida</th>
                                <th width="100">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tablaMateriasPrimasModal">
                            <tr id="noMateriasMessage">
                                <td colspan="3" class="text-center text-muted">
                                    Cargando materias primas...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        // Variables globales para la gestión de materias primas
        let materiasPrimasData = [];
        let detalleMateriasPrimas = [];
        let contadorFilas = 0;

        $(document).ready(function() {
            console.log('Document ready - iniciando carga');

            // Inicializar array vacío
            detalleMateriasPrimas = [];

            // Cargar materias primas existentes si es edición
            @if (Model.DetallesMateriasPrimas != null && Model.DetallesMateriasPrimas.Any())
            {
                <text>
                console.log('Hay materias primas para cargar');
                try {
                    var jsonData = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.DetallesMateriasPrimas, new System.Text.Json.JsonSerializerOptions { 
                        PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase,
                        WriteIndented = false
                    }));
                    console.log('Datos JSON recibidos:', jsonData);
                    
                    // Convertir los datos y asegurar que tienen la estructura correcta
                    detalleMateriasPrimas = jsonData.map(item => ({
                        Id: item.id || 0,
                        IdMateriaPrima: item.idMateriaPrima,
                        NombreMateriaPrima: item.nombreMateriaPrima || '',
                        CantidadRequerida: parseFloat(item.cantidadRequerida) || 0,
                        UnidadMedida: item.unidadMedida || 'Unidad',
                        Observaciones: item.observaciones || '',
                        Estado: item.estado !== false
                    }));
                    
                    console.log('Materias primas procesadas:', detalleMateriasPrimas);
                    
                    // Actualizar tabla inmediatamente
                    actualizarTablaMateriasPrimas();
                } catch (error) {
                    console.error('Error al procesar materias primas:', error);
                    detalleMateriasPrimas = [];
                }
                </text>
            }
            else
            {
                <text>
                console.log('No hay materias primas existentes para cargar');
                </text>
            }

            // Objeto para manejar las funciones de recetas
            window.RecetaManager = {
                // Variables para el modal de materias primas
                materiasPrimasModalData: [],
                
                // Función para cargar materias primas en el modal
                cargarMateriasPrimasModal: function() {
                    $.get('/Operaciones/Produccion/Upsert?handler=MateriasPrimas')
                        .done(function(data) {
                            if (data.success) {
                                RecetaManager.materiasPrimasModalData = data.materiasPrimas;
                                RecetaManager.mostrarMateriasPrimasModal(RecetaManager.materiasPrimasModalData);
                            } else {
                                alert('Error al cargar materias primas: ' + data.message);
                            }
                        })
                        .fail(function() {
                            alert('Error al conectar con el servidor');
                        });
                },

                // Función para mostrar materias primas en el modal
                mostrarMateriasPrimasModal: function(materiasPrimas) {
                    const tbody = $('#tablaMateriasPrimasModal');
                    tbody.empty();

                    if (materiasPrimas.length === 0) {
                        $('#noMateriasMessage').show();
                        return;
                    }

                    materiasPrimas.forEach((materia) => {
                        const row = `
                            <tr>
                                <td><strong>${materia.descripcion}</strong></td>
                                <td><span class="badge bg-info">${materia.unidadMedida}</span></td>
                                <td>
                                    <button type="button" class="btn btn-primary btn-sm" 
                                            onclick="RecetaManager.seleccionarMateriaPrima(${materia.id}, '${materia.descripcion}', '${materia.unidadMedida}')"
                                            data-bs-dismiss="modal">
                                        Seleccionar
                                    </button>
                                </td>
                            </tr>
                        `;
                        tbody.append(row);
                    });
                },

                // Función para seleccionar una materia prima del modal
                seleccionarMateriaPrima: function(id, descripcion, unidadMedida) {
                    const inputMateriaPrima = $('#inputBuscarMateriaPrima');
                    
                    // Asignar valores
                    inputMateriaPrima.val(descripcion)
                                    .data('id', id)
                                    .data('unidad-medida', unidadMedida);
                    
                    // Cambiar el estilo para indicar que se ha seleccionado
                    inputMateriaPrima.removeClass('bg-light')
                                    .addClass('bg-success')
                                    .addClass('text-white');
                    
                    // Enfocar el campo de cantidad
                    $('#inputCantidad').focus().select();
                    
                    console.log(`Materia prima seleccionada: ${descripcion} (ID: ${id}, Unidad: ${unidadMedida})`);
                },

                // Función para filtrar materias primas en el modal
                filtrarMateriasPrimas: function() {
                    const filtro = $('#filtroMateriaPrima').val().toLowerCase();
                    
                    if (!filtro) {
                        this.mostrarMateriasPrimasModal(this.materiasPrimasModalData);
                        return;
                    }

                    const materiasFiltradas = this.materiasPrimasModalData.filter(materia => 
                        materia.descripcion.toLowerCase().includes(filtro)
                    );

                    this.mostrarMateriasPrimasModal(materiasFiltradas);
                }
            };

            // Eventos
            $('#btnSeleccionarMateriaPrima').click(function() {
                RecetaManager.cargarMateriasPrimasModal();
            });

            // Hacer que el input de materia prima abra el modal al hacer clic
            $('#inputBuscarMateriaPrima').click(function() {
                $('#btnSeleccionarMateriaPrima').click();
            });

            $('#btnAgregarMateriaPrima').click(function() {
                agregarMateriaPrima();
            });

            // Solo permitir Enter en el campo de cantidad, no en el de materia prima
            $('#inputCantidad').keypress(function(e) {
                if (e.which === 13) {
                    agregarMateriaPrima();
                }
            });

            // Prevenir escritura en el input de materia prima (extra seguridad)
            $('#inputBuscarMateriaPrima').on('keydown keypress keyup', function(e) {
                e.preventDefault();
                return false;
            });

            // Evento de filtro en tiempo real en el modal
            $('#filtroMateriaPrima').keyup(function() {
                RecetaManager.filtrarMateriasPrimas();
            });

            // Función para agregar materia prima a la tabla
            function agregarMateriaPrima() {
                const materiaPrimaInput = $('#inputBuscarMateriaPrima');
                const cantidadInput = $('#inputCantidad');
                const observacionesInput = $('#inputObservaciones');

                const idMateriaPrima = materiaPrimaInput.data('id');
                const nombreMateriaPrima = materiaPrimaInput.val();
                const cantidad = parseFloat(cantidadInput.val()) || 0;
                const unidadMedida = materiaPrimaInput.data('unidad-medida');
                const observaciones = observacionesInput.val();

                // Validaciones
                if (!idMateriaPrima || !nombreMateriaPrima) {
                    alert('Debe seleccionar una materia prima usando el botón "Seleccionar".');
                    $('#btnSeleccionarMateriaPrima').focus();
                    return;
                }

                if (cantidad <= 0) {
                    alert('La cantidad debe ser mayor a 0.');
                    cantidadInput.focus();
                    return;
                }

                // Verificar si ya existe la materia prima
                const yaExiste = detalleMateriasPrimas.some(d => d.Estado && d.IdMateriaPrima === idMateriaPrima);
                if (yaExiste) {
                    alert('Esta materia prima ya está agregada a la receta.');
                    return;
                }

                // Agregar al array
                const nuevoDetalle = {
                    Id: 0,
                    IdMateriaPrima: idMateriaPrima,
                    NombreMateriaPrima: nombreMateriaPrima,
                    CantidadRequerida: cantidad,
                    UnidadMedida: unidadMedida,
                    Observaciones: observaciones,
                    Estado: true
                };

                detalleMateriasPrimas.push(nuevoDetalle);

                // Limpiar campos
                materiaPrimaInput.val('')
                                .data('id', '')
                                .data('unidad-medida', '')
                                .removeClass('bg-success text-white')
                                .addClass('bg-light');
                cantidadInput.val('1');
                observacionesInput.val('');

                // Actualizar tabla
                actualizarTablaMateriasPrimas();
                
                // Focus al botón seleccionar para siguiente agregado
                $('#btnSeleccionarMateriaPrima').focus();
            }

            // Función para actualizar la tabla de materias primas
            function actualizarTablaMateriasPrimas() {
                console.log('=== EJECUTANDO actualizarTablaMateriasPrimas ===');
                console.log('detalleMateriasPrimas completo:', detalleMateriasPrimas);
                
                const cuerpoTabla = $('#cuerpoTablaMateriasPrimas');
                const camposOcultos = $('#hiddenFieldsMateriasPrimas');
                
                if (cuerpoTabla.length === 0) {
                    console.error('No se encontró el elemento cuerpoTablaMateriasPrimas');
                    return;
                }
                
                cuerpoTabla.empty();
                camposOcultos.empty();

                const materiasPrimasActivas = detalleMateriasPrimas.filter(d => d.Estado === true);
                console.log('Materias primas activas filtradas:', materiasPrimasActivas);

                if (materiasPrimasActivas.length === 0) {
                    console.log('No hay materias primas activas, mostrando mensaje vacío');
                    cuerpoTabla.append(`
                        <tr id="filaVaciaReceta">
                            <td colspan="5" class="text-center text-muted">
                                No se han agregado materias primas. Use el buscador arriba para agregar.
                            </td>
                        </tr>
                    `);
                    return;
                }

                console.log('Construyendo tabla con', materiasPrimasActivas.length, 'materias primas');
                materiasPrimasActivas.forEach((detalle, index) => {
                    console.log(`Procesando materia prima ${index}:`, detalle);
                    
                    // Asegurar que los valores sean correctos
                    const cantidad = parseFloat(detalle.CantidadRequerida) || 0;
                    const nombreMateria = detalle.NombreMateriaPrima || 'Sin nombre';
                    const unidad = detalle.UnidadMedida || 'Unidad';
                    const observaciones = detalle.Observaciones || '';
                    
                    // Fila de la tabla
                    const fila = `
                        <tr>
                            <td><strong>${nombreMateria}</strong></td>
                            <td>${cantidad.toFixed(3)}</td>
                            <td><span class="badge bg-info">${unidad}</span></td>
                            <td>${observaciones || '<em class="text-muted">Sin observaciones</em>'}</td>
                            <td>
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="eliminarMateriaPrima(${detalleMateriasPrimas.indexOf(detalle)})">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    `;
                    cuerpoTabla.append(fila);

                    // Campos ocultos
                    camposOcultos.append(`
                        <input type="hidden" name="DetallesMateriasPrimas[${index}].Id" value="${detalle.Id || 0}" />
                        <input type="hidden" name="DetallesMateriasPrimas[${index}].IdMateriaPrima" value="${detalle.IdMateriaPrima}" />
                        <input type="hidden" name="DetallesMateriasPrimas[${index}].NombreMateriaPrima" value="${nombreMateria}" />
                        <input type="hidden" name="DetallesMateriasPrimas[${index}].CantidadRequerida" value="${cantidad}" />
                        <input type="hidden" name="DetallesMateriasPrimas[${index}].UnidadMedida" value="${unidad}" />
                        <input type="hidden" name="DetallesMateriasPrimas[${index}].Observaciones" value="${observaciones}" />
                        <input type="hidden" name="DetallesMateriasPrimas[${index}].Estado" value="${detalle.Estado}" />
                    `);
                });
                
                console.log('Tabla actualizada exitosamente');
                console.log('Contenido final del cuerpo de tabla:', cuerpoTabla.html());
            }

            // Función global para eliminar materia prima
            window.eliminarMateriaPrima = function(index) {
                if (confirm('¿Está seguro de eliminar esta materia prima de la receta?')) {
                    detalleMateriasPrimas[index].Estado = false;
                    actualizarTablaMateriasPrimas();
                }
            };

            // Exponer funciones globalmente
            window.actualizarTablaMateriasPrimas = actualizarTablaMateriasPrimas;
            
            console.log('Inicialización completa');
        });
    </script>
}