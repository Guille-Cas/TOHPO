@page "{id:int?}"
@using System.Text.Json
@model TOHPO.Pages.Operaciones.Produccion.UpsertModel
@{
    ViewData["Title"] = Model.Receta.Id == 0 ? "Nueva Receta" : "Editar Receta";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3>
                        @(Model.Receta.Id == 0 ? "Nueva Receta" : "Editar Receta")
                    </h3>
                </div>
                <div class="card-body">
                    <form method="post">
                        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                        
                        <input type="hidden" asp-for="Receta.Id" />
                        <input type="hidden" asp-for="Receta.Fecha_Creacion" />

                        <div class="row">
                            <!-- Información básica -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Receta.Descripcion" class="form-label">Descripción *</label>
                                    <input asp-for="Receta.Descripcion" type="text" class="form-control" required maxlength="200">
                                    <span asp-validation-for="Receta.Descripcion" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Receta.Codigo_Producto" class="form-label">Producto *</label>
                                    <select asp-for="Receta.Codigo_Producto" asp-items="Model.ProductosSelectList" 
                                            class="form-select" required onchange="validarProducto(this.value)">
                                        <option value="">Seleccione un producto...</option>
                                    </select>
                                    <span asp-validation-for="Receta.Codigo_Producto" class="text-danger"></span>
                                    <div id="productoInfo" class="form-text"></div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Receta.Rendimiento" class="form-label">Rendimiento *</label>
                                            <input asp-for="Receta.Rendimiento" type="number" step="0.01" min="0.01" 
                                                   class="form-control" required>
                                            <span asp-validation-for="Receta.Rendimiento" class="text-danger"></span>
                                            <div class="form-text">Cantidad que se produce con esta receta</div>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="mb-3">
                                            <label asp-for="Receta.Cantidad_Empaque" class="form-label">Cantidad Empaque</label>
                                            <input asp-for="Receta.Cantidad_Empaque" type="number" step="0.01" min="0" 
                                                   class="form-control">
                                            <span asp-validation-for="Receta.Cantidad_Empaque" class="text-danger"></span>
                                            <div class="form-text">Cantidad por empaque (opcional)</div>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <div class="form-check">
                                        <input asp-for="Receta.Estado" type="checkbox" class="form-check-input">
                                        <label asp-for="Receta.Estado" class="form-check-label">Activo</label>
                                    </div>
                                </div>
                            </div>

                            <!-- Detalles e instrucciones -->
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Receta.Detalle" class="form-label">Detalle</label>
                                    <textarea asp-for="Receta.Detalle" class="form-control" rows="4" 
                                              placeholder="Descripción detallada de la receta"></textarea>
                                    <span asp-validation-for="Receta.Detalle" class="text-danger"></span>
                                </div>

                                <div class="mb-3">
                                    <label asp-for="Receta.Instrucciones" class="form-label">Instrucciones *</label>
                                    <textarea asp-for="Receta.Instrucciones" class="form-control" rows="6" required
                                              placeholder="Pasos detallados para elaborar la receta"></textarea>
                                    <span asp-validation-for="Receta.Instrucciones" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <!-- Sección de Materias Primas -->
                        <div class="row mt-4">
                            <div class="col-12">
                                <hr>
                                <h4>Materias Primas</h4>
                                
                                <!-- Agregar Materia Prima -->
                                <div class="card mb-3">
                                    <div class="card-body">
                                        <div class="row">
                                            <div class="col-md-4">
                                                <label class="form-label">Materia Prima</label>
                                                <select id="selectMateriaPrima" class="form-select" onchange="cargarInfoMateriaPrima()">
                                                    <option value="">Seleccione una materia prima...</option>
                                                    @if (Model.MateriasPrimasSelectList != null)
                                                    {
                                                        @foreach (var item in Model.MateriasPrimasSelectList)
                                                        {
                                                            <option value="@item.Value">@item.Text</option>
                                                        }
                                                    }
                                                </select>
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Cantidad</label>
                                                <input type="number" id="inputCantidad" class="form-control" step="0.001" min="0.001" placeholder="0.000">
                                            </div>
                                            <div class="col-md-2">
                                                <label class="form-label">Unidad</label>
                                                <select id="selectUnidadMedida" class="form-select">
                                                    <option value="0">Kilogramo</option>
                                                    <option value="1">Gramo</option>
                                                    <option value="2">Litro</option>
                                                    <option value="3">Mililitro</option>
                                                    <option value="4">Unidad</option>
                                                    <option value="5">Libra</option>
                                                    <option value="6">Onza</option>
                                                </select>
                                            </div>
                                            <div class="col-md-3">
                                                <label class="form-label">Observaciones</label>
                                                <input type="text" id="inputObservaciones" class="form-control" maxlength="200" placeholder="Opcional">
                                            </div>
                                            <div class="col-md-1 d-flex align-items-end">
                                                <button type="button" class="btn btn-success" onclick="agregarMateriaPrima()">
                                                    Agregar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Lista de Materias Primas -->
                                <div class="table-responsive">
                                    <table class="table table-striped table-hover" id="tablaMateriasPrimas">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Materia Prima</th>
                                                <th>Cantidad</th>
                                                <th>Unidad</th>
                                                <th>Observaciones</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="cuerpoTablaMateriasPrimas">
                                            <!-- Se llenan dinámicamente -->
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Campos ocultos para las materias primas -->
                                <div id="camposOcultosMateriasPrimas"></div>
                            </div>
                        </div>

                        <!-- Información adicional (solo en edición) -->
                        @if (Model.Receta.Id > 0)
                        {
                            <div class="row">
                                <div class="col-12">
                                    <div class="alert alert-info">
                                        <strong>Información:</strong> Receta creada el @Model.Receta.Fecha_Creacion.ToString("dd/MM/yyyy HH:mm")
                                    </div>
                                </div>
                            </div>
                        }

                        <!-- Botones -->
                        <div class="row">
                            <div class="col-12">
                                <hr>
                                <div class="d-flex justify-content-between">
                                    <a asp-page="./Index" class="btn btn-secondary">
                                        Volver
                                    </a>
                                    <button type="submit" class="btn btn-success">
                                        @(Model.Receta.Id == 0 ? "Crear Receta" : "Actualizar Receta")
                                    </button>
                                </div>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    
    <script>
        // Inicialización mejorada para evitar errores de undefined
        let materiasPrimasSeleccionadas = [];
        let contadorMateriasPrimas = 0;
        
        // Obtener el ID de la receta actual para validaciones
        const currentRecetaId = @(Model.Receta.Id);

        // Unidades de medida
        const unidadesMedida = {
            0: 'Kilogramo',
            1: 'Gramo', 
            2: 'Litro',
            3: 'Mililitro',
            4: 'Unidad',
            5: 'Libra',
            6: 'Onza'
        };

        // CORREGIDO: Inicialización más robusta de materias primas desde el servidor
        function inicializarMateriasPrimasDesdeServidor() {
            try {
                // CORREGIDO: Mejor manejo de la serialización JSON
                const materiasPrimasDelServidor = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.MateriasPrimasSeleccionadas, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

                console.log('Datos del servidor (raw):', materiasPrimasDelServidor);
                
                if (materiasPrimasDelServidor && Array.isArray(materiasPrimasDelServidor)) {
                    materiasPrimasSeleccionadas = [];
                    
                    materiasPrimasDelServidor.forEach((mp, index) => {
                        console.log(`Procesando MP ${index}:`, mp);
                        
                        const materiaPrimaProcesada = {
                            Id: mp.id || 0,
                            Id_Materia_Prima: mp.id_Materia_Prima || mp.idMateriaPrima || 0,
                            Descripcion: mp.descripcion || 'Sin descripción',
                            Cantidad_Requerida: parseFloat(mp.cantidad_Requerida || mp.cantidadRequerida || 0),
                            Unidad_Medida: parseInt(mp.unidad_Medida || mp.unidadMedida || 0),
                            Observaciones: mp.observaciones || ''
                        };
                        
                        console.log('MP procesada:', materiaPrimaProcesada);
                        materiasPrimasSeleccionadas.push(materiaPrimaProcesada);
                    });
                    
                    console.log('Materias primas finales cargadas:', materiasPrimasSeleccionadas);
                } else {
                    console.warn('No se recibieron materias primas del servidor o el formato es incorrecto');
                }
            } catch (error) {
                console.error('Error al cargar materias primas del servidor:', error);
                materiasPrimasSeleccionadas = [];
            }
        }

        function validarProducto(codigo) {
            const infoDiv = document.getElementById('productoInfo');
            
            if (!codigo) {
                infoDiv.innerHTML = '';
                return;
            }

            let url = `?handler=ValidarProducto&codigo=${encodeURIComponent(codigo)}`;
            if (currentRecetaId > 0) {
                url += `&id=${currentRecetaId}`;
            }

            fetch(url)
                .then(response => response.json())
                .then(data => {
                    if (data.valido) {
                        infoDiv.innerHTML = `<div class="text-success">
                            Producto válido: ${data.producto.descripcion}
                            ${data.producto.categoria ? `(${data.producto.categoria})` : ''}
                        </div>`;
                    } else {
                        infoDiv.innerHTML = `<div class="text-danger">
                            ${data.mensaje}
                            ${data.recetaId ? `<br><small>Receta existente: ${data.recetaDescripcion}</small>` : ''}
                        </div>`;
                    }
                })
                .catch(error => {
                    console.error('Error:', error);
                    infoDiv.innerHTML = '<div class="text-warning">Error al validar el producto</div>';
                });
        }

        function cargarInfoMateriaPrima() {
            const select = document.getElementById('selectMateriaPrima');
            const id = select.value;
            
            if (!id) return;

            fetch(`?handler=ObtenerMateriaPrima&id=${id}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        const selectUnidad = document.getElementById('selectUnidadMedida');
                        selectUnidad.value = data.materia_prima.unidad_medida || 0;
                    }
                })
                .catch(error => console.error('Error:', error));
        }

        function agregarMateriaPrima() {
            const selectMP = document.getElementById('selectMateriaPrima');
            const inputCantidad = document.getElementById('inputCantidad');
            const selectUnidad = document.getElementById('selectUnidadMedida');
            const inputObservaciones = document.getElementById('inputObservaciones');

            if (!selectMP.value || !inputCantidad.value || parseFloat(inputCantidad.value) <= 0) {
                alert('Por favor, seleccione una materia prima y especifique una cantidad válida');
                return;
            }

            // Verificar que no esté duplicada
            const yaExiste = materiasPrimasSeleccionadas.some(mp => mp.Id_Materia_Prima == selectMP.value);
            if (yaExiste) {
                alert('Esta materia prima ya ha sido agregada a la receta');
                return;
            }

            const nuevaMateriaPrima = {
                Id: 0,
                Id_Materia_Prima: parseInt(selectMP.value),
                Descripcion: selectMP.options[selectMP.selectedIndex].text,
                Cantidad_Requerida: parseFloat(inputCantidad.value),
                Unidad_Medida: parseInt(selectUnidad.value),
                Observaciones: inputObservaciones.value || ''
            };

            materiasPrimasSeleccionadas.push(nuevaMateriaPrima);
            actualizarTablaMateriasPrimas();

            // Limpiar campos
            selectMP.value = '';
            inputCantidad.value = '';
            selectUnidad.value = '0';
            inputObservaciones.value = '';
        }

        function eliminarMateriaPrima(index) {
            if (index >= 0 && index < materiasPrimasSeleccionadas.length) {
                materiasPrimasSeleccionadas.splice(index, 1);
                actualizarTablaMateriasPrimas();
            }
        }

        function actualizarTablaMateriasPrimas() {
            const tbody = document.getElementById('cuerpoTablaMateriasPrimas');
            const camposOcultos = document.getElementById('camposOcultosMateriasPrimas');
            
            if (!tbody || !camposOcultos) {
                console.error('No se encontraron los elementos de la tabla');
                return;
            }

            tbody.innerHTML = '';
            camposOcultos.innerHTML = '';

            if (!Array.isArray(materiasPrimasSeleccionadas)) {
                console.error('materiasPrimasSeleccionadas no es un array válido');
                return;
            }

            console.log('Actualizando tabla con:', materiasPrimasSeleccionadas);

            materiasPrimasSeleccionadas.forEach((mp, index) => {
                // Validaciones para evitar errores de undefined
                const descripcion = mp.Descripcion || 'Sin descripción';
                const cantidad = (mp.Cantidad_Requerida !== undefined && mp.Cantidad_Requerida !== null) 
                    ? parseFloat(mp.Cantidad_Requerida).toFixed(3) 
                    : '0.000';
                const unidad = unidadesMedida[mp.Unidad_Medida] || 'Unidad';
                const observaciones = mp.Observaciones || '';

                console.log(`Fila ${index}: ${descripcion}, ${cantidad}, ${unidad}`);

                // Agregar fila a la tabla
                const fila = document.createElement('tr');
                fila.innerHTML = `
                    <td>${descripcion}</td>
                    <td>${cantidad}</td>
                    <td>${unidad}</td>
                    <td>${observaciones}</td>
                    <td>
                        <button type="button" class="btn btn-danger btn-sm" onclick="eliminarMateriaPrima(${index})">
                            Eliminar
                        </button>
                    </td>
                `;
                tbody.appendChild(fila);

                // Agregar campos ocultos con validaciones
                const campoOculto = document.createElement('div');
                campoOculto.innerHTML = `
                    <input type="hidden" name="MateriasPrimasSeleccionadas[${index}].Id" value="${mp.Id || 0}" />
                    <input type="hidden" name="MateriasPrimasSeleccionadas[${index}].Id_Materia_Prima" value="${mp.Id_Materia_Prima || 0}" />
                    <input type="hidden" name="MateriasPrimasSeleccionadas[${index}].Descripcion" value="${descripcion}" />
                    <input type="hidden" name="MateriasPrimasSeleccionadas[${index}].Cantidad_Requerida" value="${mp.Cantidad_Requerida || 0}" />
                    <input type="hidden" name="MateriasPrimasSeleccionadas[${index}].Unidad_Medida" value="${mp.Unidad_Medida || 0}" />
                    <input type="hidden" name="MateriasPrimasSeleccionadas[${index}].Observaciones" value="${observaciones}" />
                `;
                camposOcultos.appendChild(campoOculto);
            });
        }

        // Inicialización al cargar la página
        document.addEventListener('DOMContentLoaded', function() {
            try {
                const productoSelect = document.querySelector('select[name="Receta.Codigo_Producto"]');
                if (productoSelect && productoSelect.value) {
                    // No validar automáticamente en edición para evitar la advertencia
                    if (currentRecetaId === 0) {
                        validarProducto(productoSelect.value);
                    }
                }

                // CORREGIDO: Cargar materias primas existentes de forma segura
                console.log('Iniciando carga de materias primas...');
                inicializarMateriasPrimasDesdeServidor();
                actualizarTablaMateriasPrimas();
                console.log('Carga completada');
            } catch (error) {
                console.error('Error en la inicialización:', error);
            }
        });
    </script>
}