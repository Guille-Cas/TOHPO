@page
@model TOHPO.Pages.Operaciones.Compras.UpsertModel
@{
    ViewData["Title"] = Model.Compra.Id == 0 ? "Nueva Compra - Registro de Inventario" : "Editar Compra";
}


<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-primary text-white">
                    <h3 class="card-title">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools">
                        <a asp-page="./Index" class="btn btn-light btn-sm">
                            Volver al Listado
                        </a>
                    </div>
                </div>

                <form method="post" id="compraForm">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- CORRECCIÓN: Campo oculto para el ID de la compra -->
                        <input type="hidden" asp-for="Compra.Id" />

                        <!-- Información de la compra -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="Compra.Fecha" class="form-label">Fecha</label>
                                    <input asp-for="Compra.Fecha" class="form-control" type="date" />
                                    <span asp-validation-for="Compra.Fecha" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="Compra.Hora" class="form-label">Hora <small class="text-muted">(se actualiza automáticamente)</small></label>
                                    <input asp-for="Compra.Hora" class="form-control" type="time" 
                                           value="@Model.Compra.Hora.ToString("HH:mm")" readonly />
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-group">
                                    <label asp-for="Compra.Id_Proveedor" class="form-label">Proveedor</label>
                                    <select asp-for="Compra.Id_Proveedor" asp-items="Model.ProveedoresList" class="form-select">
                                        <option value="">-- Seleccionar Proveedor --</option>
                                    </select>
                                    <span asp-validation-for="Compra.Id_Proveedor" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Compra.Concepto" class="form-label">Concepto (Opcional)</label>
                                    <input asp-for="Compra.Concepto" value="Compra de Productos" class="form-control" placeholder="Descripción adicional de la compra..." />
                                </div>
                            </div>
                        </div>

                        <!-- Sección de agregar productos -->
                        <div class="card mb-4">
                            <div class="card-header bg-success text-white">
                                <h5 class="card-title mb-0">
                                    <i class="fas fa-scanner"></i> Agregar Productos
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-10">
                                        <div class="form-group">
                                            <label class="form-label">Código/Nombre del Producto</label>
                                            <div class="input-group">
                                                <input type="text" id="inputBuscarProducto" class="form-control form-control-lg" 
                                                       placeholder="Escanee código de barras o ingrese código del producto..." 
                                                       data-codigo="" data-porcentaje-impuesto="0"
                                                       style="font-size: 1.1rem;" />
                                                <button type="button" class="btn btn-outline-primary" id="btnSeleccionarProducto" data-bs-toggle="modal" data-bs-target="#modalSeleccionarProducto">
                                                    <i class="fas fa-search"></i> Seleccionar
                                                </button>
                                            </div>
                                            <small class="form-text text-success">
                                                <i class="fas fa-barcode"></i> <strong>Escáner activo:</strong> Escanee el código de barras y se agregará automáticamente con cantidad 1
                                            </small>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">&nbsp;</label>
                                            <div class="d-grid">
                                                <button type="button" class="btn btn-success btn-lg" id="btnAgregarProducto">
                                                    <i class="fas fa-plus"></i> Agregar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                
                                <!-- Campos ocultos para valores por defecto -->
                                <input type="hidden" id="inputCantidad" value="1" />
                                <input type="hidden" id="inputCostoUnitario" value="" />
                                <input type="hidden" id="inputDescuento" value="0" />
                                
                                <div class="row mt-2">
                                    <div class="col-12">
                                        <div class="alert alert-info">
                                            <i class="fas fa-info-circle"></i> <strong>Modo Escáner Simplificado:</strong> 
                                            Los productos se agregan automáticamente con cantidad 1, costo sugerido y sin descuento. 
                                            Puede modificar estos valores directamente en la tabla de productos.
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Lista de productos -->
                        <div class="card mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="card-title mb-0">
                                    Productos en la Compra
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped mb-0" id="productosTable">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Producto</th>
                                                <th>Cant.</th>
                                                <th>Costo Unit.</th>
                                                <th>Desc. %</th>
                                                <th>Desc. ₡</th>
                                                <th>IVA</th>
                                                <th>Subtotal</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="productosBody">
                                            <!-- Los productos se agregan dinámicamente aquí -->
                                        </tbody>
                                    </table>
                                </div>
                                <div id="emptyProductsMessage" class="text-center py-4">
                                    <h5 class="text-muted">No hay productos agregados</h5>
                                    <p class="text-muted">Comience agregando productos usando el buscador de arriba</p>
                                </div>
                            </div>
                        </div>

                        <!-- Totales -->
                        <div class="row">
                            <div class="col-md-8"></div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">Resumen de Compra</h5>
                                        <div class="d-flex justify-content-between">
                                            <span>Subtotal:</span>
                                            <span id="subtotalDisplay">₡0.00</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Descuentos:</span>
                                            <span id="descuentosDisplay">₡0.00</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>IVA:</span>
                                            <span id="ivaDisplay">₡0.00</span>
                                        </div>
                                        <hr>
                                        <div class="d-flex justify-content-between">
                                            <strong>TOTAL:</strong>
                                            <strong class="text-success fs-4" id="totalDisplay">₡0.00</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sección de métodos de pago -->
                        <div class="card mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="card-title mb-0">Métodos de Pago</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Método de Pago</label>
                                        <select id="selectMetodoPago" asp-items="Model.MetodosPagoList" class="form-select">
                                            <option value="">-- Seleccionar Método --</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Monto</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₡</span>
                                            <input type="number" id="inputMontoMetodo" class="form-control" step="0.01" min="0.01" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">&nbsp;</label>
                                        <button type="button" class="btn btn-primary d-block w-100" onclick="agregarMetodoPago()">
                                            Agregar
                                        </button>
                                    </div>
                                </div>

                                <!-- Tabla de métodos de pago -->
                                <div class="table-responsive">
                                    <table class="table table-sm" id="tablaMetodosPago">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Método de Pago</th>
                                                <th>Monto</th>
                                                <th width="80">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="bodyMetodosPago">
                                            <!-- Los métodos de pago se agregarán aquí dinámicamente -->
                                        </tbody>
                                        <tfoot>
                                            <tr class="table-info">
                                                <th>Total Pagos:</th>
                                                <th id="totalPagos">₡0.00</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                <div class="alert alert-warning" id="alertaPagos" style="display: none;">
                                    <strong>Atención:</strong> El total de pagos debe coincidir con el total de la compra.
                                </div>
                            </div>
                        </div>

                        <!-- Campos ocultos para los detalles -->
                        <div id="hiddenFields"></div>
                    </div>

                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-12 text-end">
                                <button type="submit" class="btn btn-primary btn-lg me-2" id="guardarBtn">
                                    @(Model.Compra.Id == 0 ? "Procesar Compra" : "Actualizar Compra")
                                </button>
                                <a asp-page="./Index" class="btn btn-secondary">
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal para seleccionar producto -->
<div class="modal fade" id="modalSeleccionarProducto" tabindex="-1" aria-labelledby="modalSeleccionarProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalSeleccionarProductoLabel">
                    <i class="fas fa-search"></i> Seleccionar Producto para Compra
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <input type="text" id="buscarEnModalCompra" class="form-control" 
                               placeholder="Buscar producto por nombre o código... (código de barras detectado automáticamente)"
                               autofocus />
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100" onclick="filtrarProductosCompra()">
                            <i class="fas fa-search"></i> Filtrar
                        </button>
                    </div>
                </div>

                <div class="mb-2">
                    <small class="text-muted">
                        <i class="fas fa-keyboard"></i> 
                        Atajos: <kbd>F2</kbd> Abrir selector | <kbd>F3</kbd> Agregar producto | <kbd>Enter</kbd> Buscar | <kbd>Esc</kbd> Cerrar
                    </small>
                </div>
                
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-hover" id="tablaProductosModal">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th>Nombre</th>
                                <th>Código</th>
                                <th>Cantidad en Inventario</th>
                                <th>Costo Sugerido</th>
                                <th width="120">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tablaProductosModalCompra">
                            <!-- Los productos se cargan dinámicamente -->
                        </tbody>
                    </table>
                </div>

                <!-- Mensaje cuando no hay resultados de búsqueda -->
                <div id="mensajeSinResultadosCompra" class="text-center py-4" style="display: none;">
                    <i class="fas fa-search fa-2x text-warning"></i>
                    <h5 class="text-muted mt-2">No se encontraron resultados</h5>
                    <p class="text-muted">Intenta con otros términos de búsqueda</p>
                </div>
                
                <div id="loadingProductosCompra" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando productos...</p>
                </div>

                <div id="noProductsMessage" class="text-center py-4" style="display: none;">
                    <i class="fas fa-box-open fa-3x text-muted"></i>
                    <h5 class="text-muted mt-2">No hay productos disponibles</h5>
                    <p class="text-muted">No se encontraron productos en el sistema</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/Operaciones/compras-upsert.js"></script>

    <script>
        // Variables globales - adaptadas para compras
        let productos = @Html.Raw(Json.Serialize(Model.DetallesCompra));
        let productosDisponibles = @Html.Raw(Json.Serialize(Model.ProductosDisponibles.Select(p => new { 
            codigo = p.CodigoReferencia, 
            nombre = p.Descripcion,
            porcentajeImpuesto = p.Impuesto != null ? p.Impuesto.Porcentaje : 0
        })));
        let contadorProductos = productos.length;
        let metodosPagoData = [];

        // Función para reiniciar el botón de guardar
        function reiniciarBotonGuardar() {
            const guardarBtn = $('#guardarBtn');
            const esNuevaCompra = @Json.Serialize(Model.Compra.Id == 0);
            const textoOriginal = esNuevaCompra ? 'Procesar Compra' : 'Actualizar Compra';
            
            guardarBtn.prop('disabled', false).html(textoOriginal);
        }

        // Event listener para configuración inicial
        $(document).ready(function() {
            // Reiniciar botón al cargar la página (en caso de error del servidor)
            reiniciarBotonGuardar();

            // Configurar la hora inicial sin segundos
            const horaInput = $('#Compra_Hora');
            if (horaInput.length) {
                if (horaInput.val() === '' || @Json.Serialize(Model.Compra.Id == 0)) {
                    const now = new Date();
                    const timeString = now.getHours().toString().padStart(2, '0') + ':' + 
                                      now.getMinutes().toString().padStart(2, '0');
                    horaInput.val(timeString);
                } else {
                    const currentValue = horaInput.val();
                    if (currentValue.length > 5) {
                        horaInput.val(currentValue.substring(0, 5));
                    }
                }
                
                horaInput.on('change', function() {
                    const value = $(this).val();
                    if (value && value.length > 5) {
                        $(this).val(value.substring(0, 5));
                    }
                });
            }

            // Cargar métodos de pago existentes si es edición
            if (@Json.Serialize(Model.MetodosPago != null && Model.MetodosPago.Any())) {
                metodosPagoData = @Html.Raw(Json.Serialize(Model.MetodosPago.Select(mp => new {
                    id = mp.Id,
                    idMetodoPago = mp.IdMetodoPago,
                    nombreMetodoPago = mp.NombreMetodoPago,
                    monto = mp.Monto
                })));
                actualizarTablaMetodosPago();
                actualizarValidacionPagos();
            }
        });

        // Objeto para manejar las funciones de compras
        const CompraManager = {
            // Variables para el modal de productos
            productosModalData: [],
            
            // Función para cargar productos en el modal
            cargarProductosModal: function() {
                // Obtener datos de productos con información de inventario
                $.get('/Operaciones/Compras/Upsert?handler=ProductosInventario')
                    .done(function(data) {
                        if (data.success) {
                            CompraManager.productosModalData = data.productos;
                            CompraManager.mostrarProductosModal(CompraManager.productosModalData);
                        } else {
                            alert('Error al cargar productos: ' + data.message);
                        }
                    })
                    .fail(function() {
                        alert('Error al conectar con el servidor');
                    });
            },

            // Función para mostrar productos en el modal
            mostrarProductosModal: function(productos) {
                const tbody = $('#tablaProductosModalCompra');
                tbody.empty();

                if (productos.length === 0) {
                    $('#noProductsMessage').show();
                    return;
                }

                $('#noProductsMessage').hide();

                productos.forEach((producto, index) => {
                    const row = `
                        <tr>
                            <td>
                                <strong>${producto.nombre}</strong>
                                <br><small class="text-muted">${producto.descripcion || ''}</small>
                            </td>
                            <td>${producto.codigo}</td>
                            <td>
                                <span class="badge ${producto.cantidadInventario > 0 ? 'bg-success' : 'bg-warning'}">
                                    ${producto.cantidadInventario} unidades
                                </span>
                            </td>
                            <td>₡${parseFloat(producto.costo || 0).toFixed(2)}</td>
                            <td>
                                <button type="button" class="btn btn-primary btn-sm" 
                                        onclick="CompraManager.seleccionarProducto('${producto.codigo}', '${producto.nombre}', ${producto.costo || 0})"
                                        data-bs-dismiss="modal">
                                    Seleccionar
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            },

            // Función para seleccionar un producto del modal
            seleccionarProducto: function(codigo, nombre, costo) {
                // Llamar a la función actualizada del archivo compras-upsert.js
                if (typeof seleccionarProductoCompra === 'function') {
                    seleccionarProductoCompra(codigo, nombre, costo, 0, 0);
                } else {
                    // Fallback para compatibilidad
                    $('#inputBuscarProducto').val(`${codigo}`).data('codigo', codigo);
                    $('#inputCostoUnitario').val(costo);
                    $('#inputCantidad').focus();
                }
            },

            // Función para filtrar productos en el modal
            filtrarProductos: function() {
                const filtro = $('#filtroProducto').val().toLowerCase();
                
                if (!filtro) {
                    this.mostrarProductosModal(this.productosModalData);
                    return;
                }

                const productosFiltrados = this.productosModalData.filter(producto => 
                    producto.nombre.toLowerCase().includes(filtro) || 
                    producto.codigo.toLowerCase().includes(filtro) ||
                    (producto.descripcion && producto.descripcion.toLowerCase().includes(filtro))
                );

                this.mostrarProductosModal(productosFiltrados);
            },

            // Función para buscar productos (mantenemos para compatibilidad)
            buscarProducto: function() {
                const busqueda = $('#inputBuscarProducto').val().toLowerCase();
                
                if (!busqueda) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Búsqueda requerida',
                        text: 'Ingrese un código o nombre de producto',
                        confirmButtonColor: '#d33'
                    });
                    return;
                }

                // Buscar por código
                let producto = productosDisponibles.find(p => p.codigo.toLowerCase() === busqueda);
                
                // Si no encuentra por código, buscar por nombre
                if (!producto) {
                    producto = productosDisponibles.find(p => p.nombre.toLowerCase().includes(busqueda));
                }

                if (producto) {
                    // Obtener información adicional del producto
                    $.get(`/Operaciones/Compras/Upsert?handler=ProductoInfo&codigo=${producto.codigo}`)
                        .done(function(data) {
                            if (data.success) {
                                $('#inputCostoUnitario').val(data.producto.costo || 0);
                                $('#inputBuscarProducto').val(`${data.producto.codigo} - ${data.producto.nombre}`).data('codigo', data.producto.codigo);
                                $('#inputCantidad').focus();
                            } else {
                                Swal.fire({
                                    icon: 'error',
                                    title: 'Error',
                                    text: data.message,
                                    confirmButtonColor: '#d33'
                                });
                            }
                        })
                        .fail(function() {
                            Swal.fire({
                                icon: 'error',
                                title: 'Error de conexión',
                                text: 'Error al obtener información del producto',
                                confirmButtonColor: '#d33'
                            });
                        });
                } else {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Producto no encontrado',
                        text: 'No se encontró el producto especificado',
                        confirmButtonColor: '#d33'
                    });
                    $('#inputBuscarProducto').focus();
                }
            },

            // Función para agregar productos
            agregarProducto: function() {
                const codigoBusqueda = $('#inputBuscarProducto').data('codigo') || $('#inputBuscarProducto').val().split(' - ')[0];
                const cantidad = parseInt($('#inputCantidad').val()) || 1;
                const costoUnitario = parseFloat($('#inputCostoUnitario').val()) || 0;
                const porcentajeDescuento = parseFloat($('#inputDescuento').val()) || 0;

                if (!codigoBusqueda) {
                    Swal.fire({
                        icon: 'warning',
                        title: 'Producto requerido',
                        text: 'Debe seleccionar un producto válido',
                        confirmButtonColor: '#d33'
                    });
                    $('#inputBuscarProducto').focus();
                    return;
                }

                if (costoUnitario <= 0) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Costo inválido',
                        text: 'El costo unitario debe ser mayor a 0',
                        confirmButtonColor: '#d33'
                    });
                    $('#inputCostoUnitario').focus();
                    return;
                }

                const producto = productosDisponibles.find(p => p.codigo === codigoBusqueda);
                if (!producto) {
                    Swal.fire({
                        icon: 'error',
                        title: 'Producto no válido',
                        text: 'El producto seleccionado no es válido',
                        confirmButtonColor: '#d33'
                    });
                    $('#inputBuscarProducto').focus();
                    return;
                }

                // Verificar si el producto ya está en la lista
                const existeIndex = productos.findIndex(p => p.codigoProducto === producto.codigo);
                
                if (existeIndex >= 0) {
                    // Actualizar cantidad del producto existente
                    productos[existeIndex].cantidad += cantidad;
                    productos[existeIndex].costoUnitario = costoUnitario;
                    productos[existeIndex].porcentajeDescuento = porcentajeDescuento;
                } else {
                    // Agregar nuevo producto
                    productos.push({
                        id: 0,
                        codigoProducto: producto.codigo,
                        nombreProducto: producto.nombre,
                        cantidad: cantidad,
                        costoUnitario: costoUnitario,
                        porcentajeDescuento: porcentajeDescuento,
                        montoDescuento: 0,
                        montoImpuesto: 0,
                        subtotal: 0,
                        porcentajeImpuesto: producto.porcentajeImpuesto
                    });
                }

                // Toast de confirmación
                Swal.fire({
                    toast: true,
                    position: 'top-end',
                    icon: 'success',
                    title: `${producto.nombre} agregado exitosamente a la compra`,
                    showConfirmButton: false,
                    timer: 2000
                });

                // Limpiar campos
                $('#inputBuscarProducto').val('').removeData('codigo');
                $('#inputCantidad').val(1);
                $('#inputCostoUnitario').val('');
                $('#inputDescuento').val(0);

                this.actualizarVistaProductos();
                this.calcularTotales();
            },

            // Función para eliminar productos
            eliminarProducto: function(index) {
                Swal.fire({
                    title: '¿Está seguro?',
                    text: '¿Desea eliminar este producto de la compra?',
                    icon: 'warning',
                    showCancelButton: true,
                    confirmButtonColor: '#d33',
                    cancelButtonColor: '#3085d6',
                    confirmButtonText: 'Sí, eliminar',
                    cancelButtonText: 'Cancelar'
                }).then((result) => {
                    if (result.isConfirmed) {
                        productos.splice(index, 1);
                        this.actualizarVistaProductos();
                        this.calcularTotales();
                        
                        Swal.fire({
                            toast: true,
                            position: 'top-end',
                            icon: 'success',
                            title: 'Producto eliminado',
                            showConfirmButton: false,
                            timer: 2000
                        });
                    }
                });
            },

            // Función para editar cantidad
            editarCantidad: function(index, nuevaCantidad) {
                if (nuevaCantidad > 0) {
                    productos[index].cantidad = parseInt(nuevaCantidad);
                    this.calcularTotales();
                }
            },

            // Función para editar costo
            editarCosto: function(index, nuevoCosto) {
                if (nuevoCosto > 0) {
                    productos[index].costoUnitario = parseFloat(nuevoCosto);
                    this.calcularTotales();
                }
            },

            // Función para editar descuento
            editarDescuento: function(index, nuevoDescuento) {
                if (nuevoDescuento >= 0 && nuevoDescuento <= 100) {
                    productos[index].porcentajeDescuento = parseFloat(nuevoDescuento);
                    this.calcularTotales();
                }
            },

            // Función para actualizar vista de productos
            actualizarVistaProductos: function() {
                const tbody = $('#productosBody');
                tbody.empty();

                if (productos.length === 0) {
                    $('#emptyProductsMessage').show();
                    return;
                }

                $('#emptyProductsMessage').hide();

                productos.forEach((producto, index) => {
                    const row = `
                        <tr>
                            <td>
                                <strong>${producto.nombreProducto}</strong><br>
                                <small class="text-muted">${producto.codigoProducto}</small>
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" 
                                       value="${producto.cantidad}" min="1"
                                       onchange="CompraManager.editarCantidad(${index}, this.value)" />
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" 
                                       value="${producto.costoUnitario}" min="0" step="0.01"
                                       onchange="CompraManager.editarCosto(${index}, this.value)" />
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" 
                                       value="${producto.porcentajeDescuento}" min="0" max="100" step="0.01"
                                       onchange="CompraManager.editarDescuento(${index}, this.value)" />
                            </td>
                            <td>₡${producto.montoDescuento.toFixed(2)}</td>
                            <td>₡${producto.montoImpuesto.toFixed(2)}</td>
                            <td><strong>₡${producto.subtotal.toFixed(2)}</strong></td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm" 
                                        onclick="CompraManager.eliminarProducto(${index})" title="Eliminar">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });

                this.actualizarCamposOcultos();
            },

            // Función para calcular totales
            calcularTotales: function() {
                let subtotal = 0;
                let totalDescuentos = 0;
                let totalIva = 0;
                let total = 0;

                productos.forEach(producto => {
                    // Calcular monto de descuento
                    producto.montoDescuento = (producto.costoUnitario * producto.cantidad) * (producto.porcentajeDescuento / 100);
                    
                    // Subtotal sin impuesto
                    const subtotalSinImpuesto = (producto.costoUnitario * producto.cantidad) - producto.montoDescuento;
                    
                    // Calcular impuesto
                    producto.montoImpuesto = subtotalSinImpuesto * (producto.porcentajeImpuesto / 100);
                    
                    // Subtotal final del producto
                    producto.subtotal = subtotalSinImpuesto + producto.montoImpuesto;

                    // Acumular
                    subtotal += subtotalSinImpuesto;
                    totalDescuentos += producto.montoDescuento;
                    totalIva += producto.montoImpuesto;
                    total += producto.subtotal;
                });

                // Actualizar displays
                $('#subtotalDisplay').text(`₡${subtotal.toFixed(2)}`);
                $('#descuentosDisplay').text(`₡${totalDescuentos.toFixed(2)}`);
                $('#ivaDisplay').text(`₡${totalIva.toFixed(2)}`);
                $('#totalDisplay').text(`₡${total.toFixed(2)}`);

                // Actualizar validación de pagos
                actualizarValidacionPagos();

                // Actualizar vista de productos
                this.actualizarVistaProductos();
            },

            // Función para actualizar campos ocultos
            actualizarCamposOcultos: function() {
                const container = $('#hiddenFields');
                
                // Limpiar campos previos de productos
                container.find('[name*="DetallesCompra"]').remove();

                productos.forEach((producto, index) => {
                    container.append(`
                        <input type="hidden" name="DetallesCompra[${index}].Id" value="${producto.id}" />
                        <input type="hidden" name="DetallesCompra[${index}].CodigoProducto" value="${producto.codigoProducto}" />
                        <input type="hidden" name="DetallesCompra[${index}].NombreProducto" value="${ producto.nombreProducto}" />
                        <input type="hidden" name="DetallesCompra[${index}].Cantidad" value="${producto.cantidad}" />
                        <input type="hidden" name="DetallesCompra[${index}].CostoUnitario" value="${producto.costoUnitario}" />
                        <input type="hidden" name="DetallesCompra[${index}].PorcentajeDescuento" value="${producto.porcentajeDescuento}" />
                        <input type="hidden" name="DetallesCompra[${index}].MontoDescuento" value="${producto.montoDescuento}" />
                        <input type="hidden" name="DetallesCompra[${index}].MontoImpuesto" value="${producto.montoImpuesto}" />
                        <input type="hidden" name="DetallesCompra[${index}].Subtotal" value="${producto.subtotal}" />
                        <input type="hidden" name="DetallesCompra[${index}].PorcentajeImpuesto" value="${producto.porcentajeImpuesto}" />
                    `);
                });
            }
        };

        function actualizarValidacionPagos() {
            const totalCompra = parseFloat(document.getElementById('totalDisplay').textContent.replace('₡', '').replace(',', '')) || 0;
            const totalPagos = metodosPagoData.reduce((sum, metodo) => sum + metodo.monto, 0);
            
            const alerta = document.getElementById('alertaPagos');
            
            if (totalPagos < totalCompra) {
                // Pago insuficiente - mostrar error
                alerta.style.display = 'block';
                alerta.className = 'alert alert-danger';
                alerta.innerHTML = `
                    <strong>¡Atención!</strong> 
                    Total Compra: ₡${totalCompra.toFixed(2)} - 
                    Total Pagos: ₡${totalPagos.toFixed(2)} - 
                    <strong>Faltante: ₡${(totalCompra - totalPagos).toFixed(2)}</strong>
                `;
            } else if (totalPagos > totalCompra) {
                // Pago superior - mostrar información de pago adelantado
                alerta.style.display = 'block';
                alerta.className = 'alert alert-success';
                alerta.innerHTML = `
                    <strong>Pago Realizado:</strong> ₡${totalPagos.toFixed(2)} | 
                    <strong>Total Compra:</strong> ₡${totalCompra.toFixed(2)} | 
                    <strong>Pago adelantado/exceso:</strong> ₡${(totalPagos - totalCompra).toFixed(2)}
                `;
            } else {
                // Pago exacto - ocultar alerta
                alerta.style.display = 'none';
            }
        }

        // Función mejorada para agregar método de pago
        function agregarMetodoPago() {
            const selectMetodo = document.getElementById('selectMetodoPago');
            const inputMonto = document.getElementById('inputMontoMetodo');
            
            if (!selectMetodo.value || !inputMonto.value || parseFloat(inputMonto.value) <= 0) {
                Swal.fire({
                    icon: 'warning',
                    title: 'Datos incompletos',
                    text: 'Debe seleccionar un método de pago y un monto válido',
                    confirmButtonColor: '#d33'
                });
                return;
            }

            const metodoPago = {
                id: metodosPagoData.length + 1,
                idMetodoPago: parseInt(selectMetodo.value),
                nombreMetodoPago: selectMetodo.options[selectMetodo.selectedIndex].text,
                monto: parseFloat(inputMonto.value)
            };

            metodosPagoData.push(metodoPago);
            actualizarTablaMetodosPago();
            actualizarValidacionPagos(); // Asegurarse de que se llame aquí
            
            // Limpiar campos
            selectMetodo.value = '';
            inputMonto.value = '';
            
            // Toast de confirmación
            Swal.fire({
                toast: true,
                position: 'top-end',
                icon: 'success',
                title: `Método de pago agregado: ${metodoPago.nombreMetodoPago}`,
                showConfirmButton: false,
                timer: 2000
            });
        }

        function eliminarMetodoPago(index) {
            metodosPagoData.splice(index, 1);
            actualizarTablaMetodosPago();
            actualizarValidacionPagos(); // Asegurarse de que se llame aquí también
        }

        function actualizarTablaMetodosPago() {
            const tbody = document.getElementById('bodyMetodosPago');
            tbody.innerHTML = '';

            metodosPagoData.forEach((metodo, index) => {
                const row = tbody.insertRow();
                row.innerHTML = `
                    <td>${metodo.nombreMetodoPago}</td>
                    <td>₡${metodo.monto.toFixed(2)}</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-danger" onclick="eliminarMetodoPago(${index})">
                            Eliminar
                        </button>
                    </td>
                `;
            });

            // Actualizar total de pagos
            const totalPagos = metodosPagoData.reduce((sum, metodo) => sum + metodo.monto, 0);
            document.getElementById('totalPagos').textContent = `₡${totalPagos.toFixed(2)}`;
        }

        function generarCamposOcultosMetodosPago() {
            const hiddenFields = document.getElementById('hiddenFields');
            
            // Limpiar campos previos de métodos de pago
            const prevMetodoFields = hiddenFields.querySelectorAll('[name*="MetodosPago"]');
            prevMetodoFields.forEach(field => field.remove());

            // Generar campos ocultos para métodos de pago
            metodosPagoData.forEach((metodo, index) => {
                hiddenFields.innerHTML += `
                    <input type="hidden" name="MetodosPago[${index}].IdMetodoPago" value="${metodo.idMetodoPago}" />
                    <input type="hidden" name="MetodosPago[${index}].Monto" value="${metodo.monto}" />
                `;
            });
        }

        // Inicialización cuando el documento está listo
        $(document).ready(function() {
            CompraManager.actualizarVistaProductos();
            CompraManager.calcularTotales();

            // Event listeners para el modal
            $('#modalSeleccionarProducto').on('show.bs.modal', function() {
                CompraManager.cargarProductosModal();
            });

            $('#filtroProducto').on('input', function() {
                CompraManager.filtrarProductos();
            });

            $('#btnLimpiarFiltro').on('click', function() {
                $('#filtroProducto').val('');
                CompraManager.mostrarProductosModal(CompraManager.productosModalData);
            });

            // Event listeners originales
            $('#btnBuscarProducto').on('click', function() {
                CompraManager.buscarProducto();
            });

            $('#btnAgregarProducto').on('click', function() {
                CompraManager.agregarProducto();
            });

            // Configurar búsqueda de productos con Enter
            $('#inputBuscarProducto').on('keypress', function(e) {
                if (e.which == 13) {
                    CompraManager.buscarProducto();
                    return false;
                }
            });

            // Configurar Enter para agregar producto
            $('#inputCantidad, #inputCostoUnitario, #inputDescuento').on('keypress', function(e) {
                if (e.which == 13) {
                    CompraManager.agregarProducto();
                    return false;
                }
            });

            // Validación antes de enviar - CORREGIDA CON SWEETALERT
            $('#compraForm').on('submit', function(e) {
                // Primero validar en cliente
                if (productos.length === 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Productos requeridos',
                        text: 'Debe agregar al menos un producto a la compra',
                        confirmButtonColor: '#d33'
                    });
                    reiniciarBotonGuardar();
                    return false;
                }

                if (!$('#Compra_Id_Proveedor').val()) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Proveedor requerido',
                        text: 'Debe seleccionar un proveedor',
                        confirmButtonColor: '#d33'
                    });
                    $('#Compra_Id_Proveedor').focus();
                    reiniciarBotonGuardar();
                    return false;
                }

                // Validar métodos de pago
                if (metodosPagoData.length === 0) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Métodos de pago requeridos',
                        text: 'Debe agregar al menos un método de pago',
                        confirmButtonColor: '#d33'
                    });
                    reiniciarBotonGuardar();
                    return false;
                }

                // NUEVA VALIDACIÓN: Permitir pagos superiores para manejo de flujo de caja
                const totalCompra = parseFloat(document.getElementById('totalDisplay').textContent.replace('₡', '').replace(',', '')) || 0;
                const totalPagos = metodosPagoData.reduce((sum, metodo) => sum + metodo.monto, 0);
                
                // Solo validar que el pago no sea menor que el total de la compra
                if (totalPagos < totalCompra) {
                    e.preventDefault();
                    const faltante = totalCompra - totalPagos;
                    Swal.fire({
                        icon: 'error',
                        title: 'Pago insuficiente',
                        html: `
                            <div class="text-left">
                                <p><strong>Total Compra:</strong> ₡${totalCompra.toFixed(2)}</p>
                                <p><strong>Total Pagos:</strong> ₡${totalPagos.toFixed(2)}</p>
                                <p><strong>Faltante:</strong> <span class="text-danger">₡${faltante.toFixed(2)}</span></p>
                            </div>
                        `,
                        confirmButtonColor: '#d33'
                    });
                    reiniciarBotonGuardar();
                    return false;
                }
                
                // Si el pago es mayor, mostrar confirmación del pago adelantado pero NO PREVENIR el submit
                if (totalPagos > totalCompra) {
                    const exceso = totalPagos - totalCompra;
                    // No prevenir el evento, solo mostrar información
                    e.preventDefault(); // Temporalmente prevenir para mostrar SweetAlert
                    
                    Swal.fire({
                        icon: 'info',
                        title: 'Confirmar compra con pago adelantado',
                        html: `
                            <div class="text-left">
                                <p><strong>Pago realizado:</strong> ₡${totalPagos.toFixed(2)}</p>
                                <p><strong>Total compra:</strong> ₡${totalCompra.toFixed(2)}</p>
                                <p><strong>Pago adelantado/exceso:</strong> <span class="text-success">₡${exceso.toFixed(2)}</span></p>
                            </div>
                        `,
                        showCancelButton: true,
                        confirmButtonText: 'Continuar con la compra',
                        cancelButtonText: 'Cancelar',
                        confirmButtonColor: '#28a745',
                        cancelButtonColor: '#6c757d'
                    }).then((result) => {
                        if (result.isConfirmed) {
                            // Generar campos ocultos de métodos de pago
                            generarCamposOcultosMetodosPago();

                            // Si pasa las validaciones del cliente, deshabilitar botón
                            $('#guardarBtn').prop('disabled', true).html('Procesando...');

                            // Remover este event listener temporalmente y reenviar el formulario
                            const form = $('#compraForm')[0];
                            form.removeEventListener('submit', arguments.callee);
                            form.submit();
                        } else {
                            reiniciarBotonGuardar();
                        }
                    });
                    return false;
                }

                // Si llegó aquí, pago exacto - continuar normalmente
                generarCamposOcultosMetodosPago();

                // Si pasa las validaciones del cliente, deshabilitar botón
                $('#guardarBtn').prop('disabled', true).html('Procesando...');

                // Establecer un timeout para reiniciar el botón en caso de que algo falle
                setTimeout(function() {
                    if ($('#guardarBtn').prop('disabled')) {
                        reiniciarBotonGuardar();
                    }
                }, 5000);
            });

            // Detectar si hay errores de validación del servidor y reiniciar botón
            if ($('.alert-danger').length > 0 || $('.text-danger').is(':visible')) {
                reiniciarBotonGuardar();
            }
        });
    </script>
}