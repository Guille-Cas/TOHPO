@page
@model TOHPO.Pages.Operaciones.Compras.IndexModel
@{
    ViewData["Title"] = "Gestión de Compras";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools">
                        <a asp-page="./Upsert" class="btn btn-success btn-sm">
                            Nueva Compra
                        </a>
                    </div>
                </div>

                <!-- Filtros -->
                <form method="post" asp-page-handler="Filtrar">
                    <div class="card-body border-bottom">
                        <div class="row">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="FechaInicio" class="form-label">Fecha Inicio</label>
                                    <input asp-for="FechaInicio" class="form-control" type="date" />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="FechaFin" class="form-label">Fecha Fin</label>
                                    <input asp-for="FechaFin" class="form-control" type="date" />
                                </div>
                            </div>
                            <div class="col-md-4">
                                <div class="form-group">
                                    <label asp-for="BuscarProveedor" class="form-label">Buscar Proveedor</label>
                                    <input asp-for="BuscarProveedor" class="form-control" placeholder="Nombre del proveedor..." />
                                </div>
                            </div>
                            <div class="col-md-2">
                                <div class="form-group">
                                    <label class="form-label">&nbsp;</label>
                                    <div class="d-grid">
                                        <button type="submit" class="btn btn-primary">
                                            Filtrar
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>

                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger alert-dismissible fade show" role="alert">
                            @TempData["ErrorMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-striped table-hover" id="comprasTable">
                            <thead class="table-dark">
                                <tr>
                                    <th>ID</th>
                                    <th>Fecha</th>
                                    <th>Hora</th>
                                    <th>Proveedor</th>
                                    <th>Total Items</th>
                                    <th>Subtotal</th>
                                    <th>IVA</th>
                                    <th>Total</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Compras?.Any() == true)
                                {
                                    @foreach (var compra in Model.Compras)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-primary">#@compra.Id</span>
                                            </td>
                                            <td>@compra.Fecha.ToString("dd/MM/yyyy")</td>
                                            <td>@compra.Hora.ToString("HH:mm")</td>
                                            <td>
                                                <div>
                                                    <strong>@compra.Proveedor.Nombre</strong>
                                                    <br>
                                                    <small class="text-muted">@compra.Proveedor.Correo_Electronico</small>
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge bg-info">@compra.Compra_Detalles.Sum(cd => cd.Cantidad) items</span>
                                            </td>
                                            <td>₡@compra.Costo_Total_Grabado.ToString("N2")</td>
                                            <td>₡@compra.Iva.ToString("N2")</td>
                                            <td>
                                                <strong class="text-success">₡@compra.Total.ToString("N2")</strong>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <button type="button"
                                                            class="btn btn-info btn-sm me-2 rounded"
                                                            onclick="verDetalle(@compra.Id)"
                                                            title="Ver Detalle">
                                                        Detalles
                                                    </button>
                                                    <a asp-page="./Upsert" 
                                                       asp-route-id="@compra.Id"
                                                       class="btn btn-warning btn-sm me-2 rounded"
                                                       title="Editar">
                                                        Editar
                                                    </a>
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm me-2 rounded"
                                                            onclick="confirmarEliminar(@compra.Id, '@compra.Proveedor.Nombre')"
                                                            title="Eliminar">
                                                        Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                                else
                                {
                                    <tr>
                                        <td colspan="9" class="text-center py-4">
                                            <div class="d-flex flex-column align-items-center">
                                                <h5 class="text-muted">No hay compras registradas</h5>
                                                <p class="text-muted">Comience registrando su primera compra</p>
                                                <a asp-page="./Upsert" class="btn btn-success">
                                                    Nueva Compra
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>

                    @if (Model.Compras?.Any() == true)
                    {
                        <div class="row mt-3">
                            <div class="col-md-3">
                                <div class="card bg-primary text-white">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <h6>Total Compras</h6>
                                                <h4>@Model.Compras.Count</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-success text-white">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <h6>Total Invertido</h6>
                                                <h4>₡@Model.Compras.Sum(c => c.Total).ToString("N2")</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-info text-white">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <h6>IVA Total</h6>
                                                <h4>₡@Model.Compras.Sum(c => c.Iva).ToString("N2")</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="card bg-warning text-white">
                                    <div class="card-body">
                                        <div class="d-flex justify-content-between">
                                            <div>
                                                <h6>Items Comprados</h6>
                                                <h4>@Model.Compras.SelectMany(c => c.Compra_Detalles).Sum(cd => cd.Cantidad)</h4>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para ver detalle de compra -->
<div class="modal fade" id="detalleCompraModal" tabindex="-1" aria-labelledby="detalleCompraModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detalleCompraModalLabel">
                    Detalle de Compra
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detalleCompraContent">
                <div class="text-center">
                    <div class="spinner-border" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                <button type="button" class="btn btn-primary" onclick="imprimirDetalle()">
                    Imprimir
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/Operaciones/compra.js"></script>
}