@page
@model TOHPO.Pages.Operaciones.Productos.IndexModel
@{
    ViewData["Title"] = "Productos";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        Gestión de Productos
                    </h3>
                    <div class="card-tools">
                        <a asp-page="./Upsert" class="btn btn-primary btn-sm">
                            Nuevo Producto
                        </a>
                        <a asp-page="/Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>
                <div class="card-body">
                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success alert-dismissible fade show" role="alert">
                            @TempData["SuccessMessage"]
                            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                        </div>
                    }

                    <div class="table-responsive">
                        <table class="table table-bordered table-striped" id="productosTable">
                            <thead class="thead-dark">
                                <tr>
                                    <th>Código</th>
                                    <th>Descripción</th>
                                    <th>Categoría</th>
                                    <th>Impuesto</th>
                                    <th>Presentación</th>
                                    <th>Unidad Medida</th>
                                    <th>Características</th>
                                    <th>Estado</th>
                                    <th>Acciones</th>
                                </tr>
                            </thead>
                            <tbody>
                                @if (Model.Productos != null)
                                {
                                    @foreach (var producto in Model.Productos)
                                    {
                                        <tr>
                                            <td>
                                                <span class="badge bg-secondary">@producto.CodigoReferencia</span>
                                                @if (!string.IsNullOrEmpty(producto.Codigo_Barra))
                                                {
                                                    <br><small class="text-muted">@producto.Codigo_Barra</small>
                                                }
                                            </td>
                                            <td>
                                                <strong>@producto.Descripcion</strong>
                                                @if (producto.Tiempo_De_Vida > 0)
                                                {
                                                    <br><small class="text-info">
                                                        @producto.Tiempo_De_Vida días
                                                    </small>
                                                }
                                            </td>
                                            <td>
                                                @if (producto.Categoria != null)
                                                {
                                                    <span class="badge bg-primary">@producto.Categoria.Descripcion</span>
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin categoría</span>
                                                }
                                            </td>
                                            <td>
                                                @if (producto.Impuesto != null)
                                                {
                                                    <span class="badge bg-warning text-dark">
                                                        @producto.Impuesto.Descripcion
                                                        <br>@producto.Impuesto.Porcentaje.ToString("F2")%
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="badge bg-light text-dark">Sin impuesto</span>
                                                }
                                            </td>
                                            <td>
                                                @if (producto.Presentacion != null)
                                                {
                                                    @producto.Descripcion
                                                }
                                                else
                                                {
                                                    <span class="text-muted">Sin presentación</span>
                                                }
                                            </td>
                                            <td>
                                                <span class="badge bg-info">
                                                    @switch (producto.Unidad_Medida)
                                                    {
                                                        case TOHPO.Models.Enums.Unidad_Medida.Unidad:
                                                            <text>Unidad</text>
                                                            break;
                                                        case TOHPO.Models.Enums.Unidad_Medida.Kilogramo:
                                                            <text>Kg</text>
                                                            break;
                                                        case TOHPO.Models.Enums.Unidad_Medida.Gramo:
                                                            <text>g</text>
                                                            break;
                                                        case TOHPO.Models.Enums.Unidad_Medida.Litro:
                                                            <text>L</text>
                                                            break;
                                                        case TOHPO.Models.Enums.Unidad_Medida.Mililitro:
                                                            <text>ml</text>
                                                            break;
                                                        case TOHPO.Models.Enums.Unidad_Medida.Metro:
                                                            <text>m</text>
                                                            break;
                                                        case TOHPO.Models.Enums.Unidad_Medida.Centimetro:
                                                            <text>cm</text>
                                                            break;
                                                        case TOHPO.Models.Enums.Unidad_Medida.Caja:
                                                            <text>Caja</text>
                                                            break;
                                                        case TOHPO.Models.Enums.Unidad_Medida.Paquete:
                                                            <text>Paquete</text>
                                                            break;
                                                        default:
                                                            <text>@producto.Unidad_Medida</text>
                                                            break;
                                                    }
                                                </span>
                                            </td>
                                            <td>
                                                <div class="d-flex flex-column gap-1">
                                                    @if (producto.Es_Materia_Prima)
                                                    {
                                                        <span class="badge bg-success" title="Es Materia Prima">
                                                            M.Prima
                                                        </span>
                                                    }
                                                    @if (producto.Es_De_Terceros)
                                                    {
                                                        <span class="badge bg-warning text-dark" title="Es de Terceros">
                                                           Terceros
                                                        </span>
                                                    }
                                                    @if (producto.Materia_Prima != null)
                                                    {
                                                        <small class="text-muted" title="Materia Prima Asociada">
                                                           @producto.Materia_Prima.Descripcion
                                                        </small>
                                                    }
                                                </div>
                                            </td>
                                            <td>
                                                <span class="badge @(producto.Estado ? "bg-success" : "bg-secondary")">
                                                    @(producto.Estado ? "Activo" : "Inactivo")
                                                </span>
                                            </td>
                                            <td>
                                                <div class="btn-group" role="group">
                                                    <a asp-page="./Upsert" 
                                                       asp-route-id="@producto.CodigoReferencia"
                                                       class="btn btn-warning btn-sm me-2 rounded"
                                                       title="Editar">
                                                       Editar
                                                    </a>
                                                    <button type="button"
                                                            class="btn btn-info btn-sm me-2 rounded"
                                                            data-bs-toggle="modal" 
                                                            data-bs-target="#detailModal" 
                                                            onclick="showDetails('@producto.CodigoReferencia')" 
                                                            title="Ver Detalles">
                                                        Detalles
                                                    </button>
                                                    <button type="button"
                                                            class="btn btn-danger btn-sm me-2 rounded"
                                                            onclick="confirmarEliminar('@producto.CodigoReferencia', '@producto.Descripcion')" 
                                                            title="Eliminar">
                                                        Eliminar
                                                    </button>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para detalles del producto -->
<div class="modal fade" id="detailModal" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                    Detalles del Producto
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="detalleContenido">
                <!-- Contenido dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Pasar datos de productos al JavaScript
        window.productosData = @Html.Raw(Json.Serialize(Model.Productos));
    </script>
    <script src="~/js/Operaciones/productos.js"></script>
}