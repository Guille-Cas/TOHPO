@page
@model TOHPO.Pages.Operaciones.Ventas.UpsertModel
@{
    ViewData["Title"] = Model.Venta.Id == 0 ? "Nueva Venta - Caja Registradora" : "Editar Venta";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header bg-success text-white">
                    <h3 class="card-title">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools">
                        <a asp-page="./Index" class="btn btn-light btn-sm">
                            Volver al Listado
                        </a>
                    </div>
                </div>

                <form method="post" id="ventaForm">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- CORRECCIÓN: Campo oculto para el ID de la venta -->
                        <input type="hidden" asp-for="Venta.Id" />

                        <!-- Información de la venta -->
                        <div class="row mb-4">
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="Venta.Fecha" class="form-label">Fecha</label>
                                    <input asp-for="Venta.Fecha" class="form-control" type="date" />
                                    <span asp-validation-for="Venta.Fecha" class="text-danger"></span>
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="Venta.Hora" class="form-label">Hora <small class="text-muted">(se actualiza automáticamente)</small></label>
                                    <input asp-for="Venta.Hora" class="form-control" type="time" 
                                           value="@Model.Venta.Hora.ToString("HH:mm")" readonly />
                                </div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-group">
                                    <label asp-for="Venta.Id_Cliente" class="form-label">Cliente</label>
                                    <select asp-for="Venta.Id_Cliente" asp-items="Model.ClientesList" class="form-select">
                                        <option value="">-- Seleccionar Cliente --</option>
                                    </select>
                                    <span asp-validation-for="Venta.Id_Cliente" class="text-danger"></span>
                                </div>
                            </div>
                            
                        </div>

                        <div class="row mb-4">
                            <div class="col-12">
                                <div class="form-group">
                                    <label asp-for="Venta.Concepto" class="form-label">Concepto (Opcional)</label>
                                    <input asp-for="Venta.Concepto" value="Venta de Productos" class="form-control" placeholder="Descripción adicional de la venta..." />
                                </div>
                            </div>
                        </div>

                        <!-- Sección de agregar productos -->
                        <div class="card mb-4">
                            <div class="card-header bg-primary text-white">
                                <h5 class="card-title mb-0">
                                    Agregar Productos
                                </h5>
                            </div>
                            <div class="card-body">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-group">
                                            <label class="form-label">Producto Seleccionado</label>
                                            <div class="input-group">
                                                <input type="text" id="inputBuscarProducto" class="form-control" placeholder="Haga clic en 'Seleccionar' para elegir un producto..." readonly />
                                                <button type="button" class="btn btn-outline-secondary" id="btnBuscarProducto">
                                                    <i class="fas fa-search"></i> Seleccionar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">Cantidad</label>
                                            <input type="number" id="inputCantidad" class="form-control" value="1" min="1" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">Precio Unit.</label>
                                            <input type="number" id="inputPrecioUnitario" class="form-control" step="0.01" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">Desc. %</label>
                                            <input type="number" id="inputDescuento" class="form-control" value="0" min="0" max="100" step="0.01" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <div class="form-group">
                                            <label class="form-label">&nbsp;</label>
                                            <div class="d-grid">
                                                <button type="button" class="btn btn-success" id="btnAgregarProducto">
                                                    Agregar
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Lista de productos -->
                        <div class="card mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="card-title mb-0">
                                    Productos en la Venta
                                </h5>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table table-striped mb-0" id="productosTable">
                                        <thead class="table-dark">
                                            <tr>
                                                <th>Producto</th>
                                                <th>Cant.</th>
                                                <th>P. Unit.</th>
                                                <th>Desc. %</th>
                                                <th>Desc. ₡</th>
                                                <th>IVA</th>
                                                <th>Subtotal</th>
                                                <th>Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="productosBody">
                                            <!-- Los productos se agregan dinámicamente aquí -->
                                        </tbody>
                                    </table>
                                </div>
                                <div id="emptyProductsMessage" class="text-center py-4">
                                    <h5 class="text-muted">No hay productos agregados</h5>
                                    <p class="text-muted">Comience agregando productos usando el selector de arriba</p>
                                </div>
                            </div>
                        </div>

                        <!-- Totales -->
                        <div class="row">
                            <div class="col-md-8"></div>
                            <div class="col-md-4">
                                <div class="card bg-light">
                                    <div class="card-body">
                                        <h5 class="card-title">Resumen de Venta</h5>
                                        <div class="d-flex justify-content-between">
                                            <span>Subtotal:</span>
                                            <span id="subtotalDisplay">₡0.00</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>Descuentos:</span>
                                            <span id="descuentosDisplay">₡0.00</span>
                                        </div>
                                        <div class="d-flex justify-content-between">
                                            <span>IVA:</span>
                                            <span id="ivaDisplay">₡0.00</span>
                                        </div>
                                        <hr>
                                        <div class="d-flex justify-content-between">
                                            <strong>TOTAL:</strong>
                                            <strong class="text-success fs-4" id="totalDisplay">₡0.00</strong>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Sección de métodos de pago -->
                        <div class="card mb-4">
                            <div class="card-header bg-info text-white">
                                <h5 class="card-title mb-0">Métodos de Pago</h5>
                            </div>
                            <div class="card-body">
                                <div class="row mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label">Método de Pago</label>
                                        <select id="selectMetodoPago" asp-items="Model.MetodosPagoList" class="form-select">
                                            <option value="">-- Seleccionar Método --</option>
                                        </select>
                                    </div>
                                    <div class="col-md-4">
                                        <label class="form-label">Monto</label>
                                        <div class="input-group">
                                            <span class="input-group-text">₡</span>
                                            <input type="number" id="inputMontoMetodo" class="form-control" step="0.01" min="0.01" />
                                        </div>
                                    </div>
                                    <div class="col-md-2">
                                        <label class="form-label">&nbsp;</label>
                                        <button type="button" class="btn btn-primary d-block w-100" onclick="agregarMetodoPago()">
                                            Agregar
                                        </button>
                                    </div>
                                </div>

                                <!-- Tabla de métodos de pago -->
                                <div class="table-responsive">
                                    <table class="table table-sm" id="tablaMetodosPago">
                                        <thead class="table-light">
                                            <tr>
                                                <th>Método de Pago</th>
                                                <th>Monto</th>
                                                <th width="80">Acciones</th>
                                            </tr>
                                        </thead>
                                        <tbody id="bodyMetodosPago">
                                            <!-- Los métodos de pago se agregarán aquí dinámicamente -->
                                        </tbody>
                                        <tfoot>
                                            <tr class="table-info">
                                                <th>Total Pagos:</th>
                                                <th id="totalPagos">₡0.00</th>
                                                <th></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>

                                <div class="alert alert-warning" id="alertaPagos" style="display: none;">
                                    <strong>Atención:</strong> El total de pagos debe coincidir con el total de la venta.
                                </div>
                            </div>
                        </div>

                        <!-- Campos ocultos para los detalles -->
                        <div id="hiddenFields"></div>
                    </div>

                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-12 text-end">
                                <button type="submit" class="btn btn-success btn-lg me-2" id="guardarBtn">
                                    @(Model.Venta.Id == 0 ? "Procesar Venta" : "Actualizar Venta")
                                </button>
                                <a asp-page="./Index" class="btn btn-secondary">
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<!-- Modal de Selección de Productos -->
<div class="modal fade" id="modalSeleccionProductos" tabindex="-1" aria-labelledby="modalSeleccionProductosLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalSeleccionProductosLabel">
                    <i class="fas fa-search"></i> Seleccionar Producto
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-md-8">
                        <input type="text" id="buscarEnModal" class="form-control" 
                               placeholder="Buscar producto por nombre o código... (código de barras detectado automáticamente)"
                               autofocus>
                    </div>
                    <div class="col-md-4">
                        <button type="button" class="btn btn-outline-primary w-100" onclick="filtrarProductos()">
                            <i class="fas fa-search"></i> Filtrar
                        </button>
                    </div>
                </div>

                <div class="mb-2">
                    <small class="text-muted">
                        <i class="fas fa-keyboard"></i> 
                        Atajos: <kbd>F2</kbd> Abrir selector | <kbd>F3</kbd> Agregar producto | <kbd>Enter</kbd> Buscar | <kbd>Esc</kbd> Cerrar
                    </small>
                </div>
                
                <div class="table-responsive" style="max-height: 500px; overflow-y: auto;">
                    <table class="table table-striped table-hover">
                        <thead class="table-dark sticky-top">
                            <tr>
                                <th>Nombre</th>
                                <th>Código</th>
                                <th>Cantidad en Inventario</th>
                                <th>Precio Unitario</th>
                                <th width="120">Acción</th>
                            </tr>
                        </thead>
                        <tbody id="tablaProductosModal">
                            <!-- Los productos se cargarán dinámicamente aquí -->
                        </tbody>
                    </table>
                </div>

                <!-- Mensaje cuando no hay resultados de búsqueda -->
                <div id="mensajeSinResultados" class="text-center py-4" style="display: none;">
                    <i class="fas fa-search fa-2x text-warning"></i>
                    <h5 class="text-muted mt-2">No se encontraron resultados</h5>
                    <p class="text-muted">Intenta con otros términos de búsqueda</p>
                </div>
                
                <div id="loadingProductos" class="text-center py-4" style="display: none;">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                    <p class="mt-2">Cargando productos...</p>
                </div>
                
                <div id="noProductosMessage" class="text-center py-4" style="display: none;">
                    <i class="fas fa-box-open fa-3x text-muted"></i>
                    <h5 class="text-muted mt-2">No hay productos disponibles</h5>
                    <p class="text-muted">No se encontraron productos con existencias en inventario</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                    <i class="fas fa-times"></i> Cancelar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script src="~/js/Operaciones/ventas-upsert.js"></script>
    <script>
        // Variables globales
        let productos = @Html.Raw(Json.Serialize(Model.DetallesVenta));
        let productosDisponibles = [];
        let contadorProductos = productos.length;
        let metodosPagoData = [];

        // Función para reiniciar el botón de guardar
        function reiniciarBotonGuardar() {
            const guardarBtn = $('#guardarBtn');
            const esNuevaVenta = @Json.Serialize(Model.Venta.Id == 0);
            const textoOriginal = esNuevaVenta ? 'Procesar Venta' : 'Actualizar Venta';
            
            guardarBtn.prop('disabled', false).html(textoOriginal);
        }

        // Event listener para selección de agente
        $(document).ready(function() {
            // Reiniciar botón al cargar la página (en caso de error del servidor)
            reiniciarBotonGuardar();

            // Configurar la hora inicial sin segundos (mejorado)
            const horaInput = $('#Venta_Hora');
            if (horaInput.length) {
                // Si no hay valor o si queremos una nueva venta, establecer hora actual
                if (horaInput.val() === '' || @Json.Serialize(Model.Venta.Id == 0)) {
                    const now = new Date();
                    const timeString = now.getHours().toString().padStart(2, '0') + ':' + 
                                      now.getMinutes().toString().padStart(2, '0');
                    horaInput.val(timeString);
                } else {
                    // Para edición, asegurar formato HH:mm
                    const currentValue = horaInput.val();
                    if (currentValue.length > 5) {
                        horaInput.val(currentValue.substring(0, 5));
                    }
                }
                
                // Evento para formatear la hora cuando cambie
                horaInput.on('change', function() {
                    const value = $(this).val();
                    if (value && value.length > 5) {
                        $(this).val(value.substring(0, 5));
                    }
                });
            }

            // Cargar métodos de pago existentes si es edición
            if (@Json.Serialize(Model.MetodosPago != null && Model.MetodosPago.Any())) {
                metodosPagoData = @Html.Raw(Json.Serialize(Model.MetodosPago.Select(mp => new {
                    id = mp.Id,
                    idMetodoPago = mp.IdMetodoPago,
                    nombreMetodoPago = mp.NombreMetodoPago,
                    monto = mp.Monto
                })));
                actualizarTablaMetodosPago();
                actualizarValidacionPagos();
            }
        });

        // Objeto para manejar las funciones de ventas
        const VentaManager = {
            // NUEVA: Función para mostrar el modal de productos
            mostrarModalProductos: function() {
                $('#modalSeleccionProductos').modal('show');
                this.cargarProductosInventario();
            },

            // NUEVA: Función para cargar productos del inventario
            cargarProductosInventario: function() {
                $('#loadingProductos').show();
                $('#noProductosMessage').hide();
                $('#tablaProductosModal').empty();

                $.get('/Operaciones/Ventas/Upsert?handler=ProductosInventario')
                    .done(function(response) {
                        $('#loadingProductos').hide();
                        
                        if (response.success && response.productos && response.productos.length > 0) {
                            productosDisponibles = response.productos;
                            VentaManager.renderizarTablaProductos(response.productos);
                        } else {
                            $('#noProductosMessage').show();
                        }
                    })
                    .fail(function() {
                        $('#loadingProductos').hide();
                        $('#noProductosMessage').show();
                        alert('Error al cargar los productos del inventario');
                    });
            },

            // NUEVA: Función para renderizar la tabla de productos en el modal
            renderizarTablaProductos: function(productos) {
                const tbody = $('#tablaProductosModal');
                tbody.empty();

                productos.forEach(producto => {
                    const row = `
                        <tr>
                            <td>
                                <strong>${producto.nombre}</strong>
                            </td>
                            <td>
                                <small class="text-muted">${producto.codigo}</small>
                            </td>
                            <td class="text-center">
                                <span class="badge ${producto.cantidadInventario > 10 ? 'bg-success' : producto.cantidadInventario > 0 ? 'bg-warning' : 'bg-danger'}">
                                    ${producto.cantidadInventario}
                                </span>
                            </td>
                            <td class="text-end">₡${producto.precioUnitario.toFixed(2)}</td>
                            <td class="text-center">
                                <button type="button" class="btn btn-primary btn-sm w-100" 
                                        onclick="VentaManager.seleccionarProducto('${producto.codigo}', '${producto.nombre.replace(/'/g, "\\'")}', ${producto.precioUnitario}, ${producto.porcentajeImpuesto})">
                                    <i class="fas fa-check"></i> Seleccionar
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });
            },

            // NUEVA: Función para seleccionar un producto del modal
            seleccionarProducto: function(codigo, nombre, precio, porcentajeImpuesto) {
                // Llenar campos
                $('#inputBuscarProducto').val(`${codigo} - ${nombre}`).data('codigo', codigo);
                $('#inputPrecioUnitario').val(precio);
                
                // Almacenar porcentaje de impuesto
                $('#inputBuscarProducto').data('porcentajeImpuesto', porcentajeImpuesto);
                
                // Cerrar modal
                $('#modalSeleccionProductos').modal('hide');
                
                // Enfocar cantidad
                $('#inputCantidad').focus().select();
            },

            // Función para agregar productos (actualizada)
            agregarProducto: function() {
                const codigoBusqueda = $('#inputBuscarProducto').data('codigo');
                const nombreProducto = $('#inputBuscarProducto').val();
                const cantidad = parseInt($('#inputCantidad').val()) || 1;
                const precioUnitario = parseFloat($('#inputPrecioUnitario').val()) || 0;
                const porcentajeDescuento = parseFloat($('#inputDescuento').val()) || 0;
                const porcentajeImpuesto = $('#inputBuscarProducto').data('porcentajeImpuesto') || 0;

                if (!codigoBusqueda || !nombreProducto) {
                    alert('Debe seleccionar un producto válido desde el modal');
                    return;
                }

                if (precioUnitario <= 0) {
                    alert('El precio unitario debe ser mayor a 0');
                    return;
                }

                if (cantidad <= 0) {
                    alert('La cantidad debe ser mayor a 0');
                    return;
                }

                // Verificar si el producto ya está en la lista
                const existeIndex = productos.findIndex(p => p.codigoProducto === codigoBusqueda);
                
                if (existeIndex >= 0) {
                    // Actualizar cantidad del producto existente
                    productos[existeIndex].cantidad += cantidad;
                    productos[existeIndex].precioUnitario = precioUnitario;
                    productos[existeIndex].porcentajeDescuento = porcentajeDescuento;
                } else {
                    // Agregar nuevo producto
                    productos.push({
                        id: 0,
                        codigoProducto: codigoBusqueda,
                        nombreProducto: nombreProducto.split(' - ')[1] || nombreProducto,
                        cantidad: cantidad,
                        precioUnitario: precioUnitario,
                        porcentajeDescuento: porcentajeDescuento,
                        montoDescuento: 0,
                        montoImpuesto: 0,
                        subtotal: 0,
                        porcentajeImpuesto: porcentajeImpuesto
                    });
                }

                // Limpiar campos
                $('#inputBuscarProducto').val('').removeData('codigo').removeData('porcentajeImpuesto');
                $('#inputCantidad').val(1);
                $('#inputPrecioUnitario').val('');
                $('#inputDescuento').val(0);

                this.actualizarVistaProductos();
                this.calcularTotales();
            },

            // Función para eliminar productos
            eliminarProducto: function(index) {
                if (confirm('¿Está seguro de eliminar este producto?')) {
                    productos.splice(index, 1);
                    this.actualizarVistaProductos();
                    this.calcularTotales();
                }
            },

            // Función para editar cantidad
            editarCantidad: function(index, nuevaCantidad) {
                if (nuevaCantidad > 0) {
                    productos[index].cantidad = parseInt(nuevaCantidad);
                    this.calcularTotales();
                }
            },

            // Función para editar precio
            editarPrecio: function(index, nuevoPrecio) {
                if (nuevoPrecio > 0) {
                    productos[index].precioUnitario = parseFloat(nuevoPrecio);
                    this.calcularTotales();
                }
            },

            // Función para editar descuento
            editarDescuento: function(index, nuevoDescuento) {
                if (nuevoDescuento >= 0 && nuevoDescuento <= 100) {
                    productos[index].porcentajeDescuento = parseFloat(nuevoDescuento);
                    this.calcularTotales();
                }
            },

            // Función para actualizar vista de productos
            actualizarVistaProductos: function() {
                const tbody = $('#productosBody');
                tbody.empty();

                if (productos.length === 0) {
                    $('#emptyProductsMessage').show();
                    return;
                }

                $('#emptyProductsMessage').hide();

                productos.forEach((producto, index) => {
                    const row = `
                        <tr>
                            <td>
                                <strong>${producto.nombreProducto}</strong><br>
                                <small class="text-muted">${producto.codigoProducto}</small>
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" 
                                       value="${producto.cantidad}" min="1"
                                       onchange="VentaManager.editarCantidad(${index}, this.value)" />
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" 
                                       value="${producto.precioUnitario}" min="0" step="0.01"
                                       onchange="VentaManager.editarPrecio(${index}, this.value)" />
                            </td>
                            <td>
                                <input type="number" class="form-control form-control-sm" 
                                       value="${producto.porcentajeDescuento}" min="0" max="100" step="0.01"
                                       onchange="VentaManager.editarDescuento(${index}, this.value)" />
                            </td>
                            <td>₡${producto.montoDescuento.toFixed(2)}</td>
                            <td>₡${producto.montoImpuesto.toFixed(2)}</td>
                            <td><strong>₡${producto.subtotal.toFixed(2)}</strong></td>
                            <td>
                                <button type="button" class="btn btn-danger btn-sm" 
                                        onclick="VentaManager.eliminarProducto(${index})" title="Eliminar">
                                    Eliminar
                                </button>
                            </td>
                        </tr>
                    `;
                    tbody.append(row);
                });

                this.actualizarCamposOcultos();
            },

            // Función para calcular totales
            calcularTotales: function() {
                let subtotal = 0;
                let totalDescuentos = 0;
                let totalIva = 0;
                let total = 0;

                productos.forEach(producto => {
                    // Calcular monto de descuento
                    producto.montoDescuento = (producto.precioUnitario * producto.cantidad) * (producto.porcentajeDescuento / 100);
                    
                    // Subtotal sin impuesto
                    const subtotalSinImpuesto = (producto.precioUnitario * producto.cantidad) - producto.montoDescuento;
                    
                    // Calcular impuesto
                    producto.montoImpuesto = subtotalSinImpuesto * (producto.porcentajeImpuesto / 100);
                    
                    // Subtotal final del producto
                    producto.subtotal = subtotalSinImpuesto + producto.montoImpuesto;

                    // Acumular
                    subtotal += subtotalSinImpuesto;
                    totalDescuentos += producto.montoDescuento;
                    totalIva += producto.montoImpuesto;
                    total += producto.subtotal;
                });

                // Actualizar displays
                $('#subtotalDisplay').text(`₡${subtotal.toFixed(2)}`);
                $('#descuentosDisplay').text(`₡${totalDescuentos.toFixed(2)}`);
                $('#ivaDisplay').text(`₡${totalIva.toFixed(2)}`);
                $('#totalDisplay').text(`₡${total.toFixed(2)}`);

                // Actualizar validación de pagos
                actualizarValidacionPagos();

                // Actualizar vista de productos
                this.actualizarVistaProductos();
            },

            // Función para actualizar campos ocultos
            actualizarCamposOcultos: function() {
                const container = $('#hiddenFields');
                
                // Limpiar campos previos de productos
                container.find('[name*="DetallesVenta"]').remove();

                productos.forEach((producto, index) => {
                    container.append(`
                        <input type="hidden" name="DetallesVenta[${index}].Id" value="${producto.id}" />
                        <input type="hidden" name="DetallesVenta[${index}].CodigoProducto" value="${producto.codigoProducto}" />
                        <input type="hidden" name="DetallesVenta[${index}].NombreProducto" value="${producto.nombreProducto}" />
                        <input type="hidden" name="DetallesVenta[${index}].Cantidad" value="${producto.cantidad}" />
                        <input type="hidden" name="DetallesVenta[${index}].PrecioUnitario" value="${producto.precioUnitario}" />
                        <input type="hidden" name="DetallesVenta[${index}].PorcentajeDescuento" value="${producto.porcentajeDescuento}" />
                        <input type="hidden" name="DetallesVenta[${index}].MontoDescuento" value="${producto.montoDescuento}" />
                        <input type="hidden" name="DetallesVenta[${index}].MontoImpuesto" value="${producto.montoImpuesto}" />
                        <input type="hidden" name="DetallesVenta[${index}].Subtotal" value="${producto.subtotal}" />
                        <input type="hidden" name="DetallesVenta[${index}].PorcentajeImpuesto" value="${producto.porcentajeImpuesto}" />
                    `);
                });
            }
        };

        // NUEVA: Función para filtrar productos en el modal
        function filtrarProductos() {
            const filtro = $('#buscarEnModal').val().toLowerCase();
            
            if (!productosDisponibles || productosDisponibles.length === 0) {
                return;
            }

            let productosFiltrados = productosDisponibles;
            
            if (filtro.trim() !== '') {
                productosFiltrados = productosDisponibles.filter(producto => 
                    producto.nombre.toLowerCase().includes(filtro) ||
                    producto.codigo.toLowerCase().includes(filtro)
                );
            }

            VentaManager.renderizarTablaProductos(productosFiltrados);

            // Mostrar mensaje de sin resultados
            if (productosFiltrados.length === 0) {
                $('#mensajeSinResultados').show();
            } else {
                $('#mensajeSinResultados').hide();
            }
        }

        // Inicialización cuando el documento está listo
        $(document).ready(function() {
            VentaManager.actualizarVistaProductos();
            VentaManager.calcularTotales();

            // Event listeners actualizados
            $('#btnBuscarProducto').on('click', function() {
                VentaManager.mostrarModalProductos();
            });

            $('#btnAgregarProducto').on('click', function() {
                VentaManager.agregarProducto();
            });

            // Configurar búsqueda en el modal
            $('#buscarEnModal').on('keypress', function(e) {
                if (e.which == 13) {
                    filtrarProductos();
                    return false;
                }
            });

            // Configurar Enter para agregar producto
            $('#inputCantidad, #inputPrecioUnitario, #inputDescuento').on('keypress', function(e) {
                if (e.which == 13) {
                    VentaManager.agregarProducto();
                    return false;
                }
            });

            // Validación antes de enviar con reinicio del botón en caso de fallo
            $('#ventaForm').on('submit', function(e) {
                // Primero validar en cliente
                if (productos.length === 0) {
                    e.preventDefault();
                    alert('Debe agregar al menos un producto a la venta');
                    reiniciarBotonGuardar(); // Reiniciar botón
                    return false;
                }

                if (!$('#Venta_Id_Cliente').val()) {
                    e.preventDefault();
                    alert('Debe seleccionar un cliente');
                    $('#Venta_Id_Cliente').focus();
                    reiniciarBotonGuardar(); // Reiniciar botón
                    return false;
                }

                // Validar métodos de pago
                if (metodosPagoData.length === 0) {
                    e.preventDefault();
                    alert('Debe agregar al menos un método de pago');
                    reiniciarBotonGuardar();
                    return false;
                }

                // Validar que los totales coincidan
                const totalVenta = parseFloat(document.getElementById('totalDisplay').textContent.replace('₡', '').replace(',', '')) || 0;
                const totalPagos = metodosPagoData.reduce((sum, metodo) => sum + metodo.monto, 0);
                
                if (Math.abs(totalVenta - totalPagos) > 0.01) {
                    e.preventDefault();
                    reiniciarBotonGuardar();
                    return false;
                }

                // Generar campos ocultos de métodos de pago
                generarCamposOcultosMetodosPago();

                // Si pasa las validaciones del cliente, deshabilitar botón
                $('#guardarBtn').prop('disabled', true).html('Procesando...');

                // Establecer un timeout para reiniciar el botón en caso de que algo falle
                setTimeout(function() {
                    // Solo reiniciar si todavía está deshabilitado (indica que algo falló)
                    if ($('#guardarBtn').prop('disabled')) {
                        reiniciarBotonGuardar();
                    }
                }, 5000); // 5 segundos de timeout
            });

            // Detectar si hay errores de validación del servidor y reiniciar botón
            if ($('.alert-danger').length > 0 || $('.text-danger').is(':visible')) {
                reiniciarBotonGuardar();
            }
        });

        // Funciones de métodos de pago (mantenidas exactamente como estaban)
        function agregarMetodoPago() {
            const selectMetodo = document.getElementById('selectMetodoPago');
            const inputMonto = document.getElementById('inputMontoMetodo');
            
            if (!selectMetodo.value || !inputMonto.value || parseFloat(inputMonto.value) <= 0) {
                alert('Debe seleccionar un método de pago y un monto válido');
                return;
            }

            const metodoPago = {
                id: metodosPagoData.length + 1,
                idMetodoPago: parseInt(selectMetodo.value),
                nombreMetodoPago: selectMetodo.options[selectMetodo.selectedIndex].text,
                monto: parseFloat(inputMonto.value)
            };

            metodosPagoData.push(metodoPago);
            actualizarTablaMetodosPago();
            actualizarValidacionPagos();
            
            // Limpiar campos
            selectMetodo.value = '';
            inputMonto.value = '';
        }

        function eliminarMetodoPago(index) {
            metodosPagoData.splice(index, 1);
            actualizarTablaMetodosPago();
            actualizarValidacionPagos();
        }

        function actualizarTablaMetodosPago() {
            const tbody = document.getElementById('bodyMetodosPago');
            tbody.innerHTML = '';

            metodosPagoData.forEach((metodo, index) => {
                const row = tbody.insertRow();
                row.innerHTML = `
                    <td>${metodo.nombreMetodoPago}</td>
                    <td>₡${metodo.monto.toFixed(2)}</td>
                    <td>
                        <button type="button" class="btn btn-sm btn-danger" onclick="eliminarMetodoPago(${index})">
                            Eliminar
                        </button>
                    </td>
                `;
            });

            // Actualizar total de pagos
            const totalPagos = metodosPagoData.reduce((sum, metodo) => sum + metodo.monto, 0);
            document.getElementById('totalPagos').textContent = `₡${totalPagos.toFixed(2)}`;
        }

        function actualizarValidacionPagos() {
            const totalVenta = parseFloat(document.getElementById('totalDisplay').textContent.replace('₡', '').replace(',', '')) || 0;
            const totalPagos = metodosPagoData.reduce((sum, metodo) => sum + metodo.monto, 0);
            
            const alerta = document.getElementById('alertaPagos');
            
            if (Math.abs(totalVenta - totalPagos) > 0.01 && totalPagos > 0) {
                alerta.style.display = 'block';
                alerta.innerHTML = `
                    <strong>Atención:</strong> 
                    Total Venta: ₡${totalVenta.toFixed(2)} - 
                    Total Pagos: ₡${totalPagos.toFixed(2)} - 
                    Diferencia: ₡${(totalVenta - totalPagos).toFixed(2)}
                `;
            } else {
                alerta.style.display = 'none';
            }
        }

        function generarCamposOcultosMetodosPago() {
            const hiddenFields = document.getElementById('hiddenFields');
            
            // Limpiar campos previos de métodos de pago
            const prevMetodoFields = hiddenFields.querySelectorAll('[name*="MetodosPago"]');
            prevMetodoFields.forEach(field => field.remove());

            // Generar campos ocultos para métodos de pago
            metodosPagoData.forEach((metodo, index) => {
                hiddenFields.innerHTML += `
                    <input type="hidden" name="MetodosPago[${index}].IdMetodoPago" value="${metodo.idMetodoPago}" />
                    <input type="hidden" name="MetodosPago[${index}].Monto" value="${metodo.monto}" />
                `;
            });
        }

        // Modificar la función de guardar existente para incluir métodos de pago
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.getElementById('ventaForm');
            if (form) {
                form.addEventListener('submit', function(e) {
                    generarCamposOcultosMetodosPago();
                    
                    // Validar que haya métodos de pago
                    if (metodosPagoData.length === 0) {
                        e.preventDefault();
                        Swal.fire({
                            icon: 'warning',
                            title: 'Métodos de pago requeridos',
                            text: 'Debe agregar al menos un método de pago',
                            confirmButtonColor: '#d33'
                        });
                        return false;
                    }
                    
                    // NUEVA VALIDACIÓN: Permitir pagos superiores para manejo de flujo de caja
                    const totalVenta = parseFloat(document.getElementById('totalDisplay').textContent.replace('₡', '').replace(',', '')) || 0;
                    const totalPagos = metodosPagoData.reduce((sum, metodo) => sum + metodo.monto, 0);
                    
                    // Solo validar que el pago no sea menor que el total de la venta
                    if (totalPagos < totalVenta) {
                        e.preventDefault();
                        const faltante = totalVenta - totalPagos;
                        Swal.fire({
                            icon: 'error',
                            title: 'Pago insuficiente',
                            html: `
                                <div class="text-left">
                                    <p><strong>Total Venta:</strong> ₡${totalVenta.toFixed(2)}</p>
                                    <p><strong>Total Pagos:</strong> ₡${totalPagos.toFixed(2)}</p>
                                    <p><strong>Faltante:</strong> <span class="text-danger">₡${faltante.toFixed(2)}</span></p>
                                </div>
                            `,
                            confirmButtonColor: '#d33'
                        });
                        return false;
                    }
                    
                    // Si el pago es mayor, mostrar confirmación del vuelto pero NO PREVENIR el submit
                    if (totalPagos > totalVenta) {
                        const vuelto = totalPagos - totalVenta;
                        // No prevenir el evento, solo mostrar información
                        e.preventDefault(); // Temporalmente prevenir para mostrar SweetAlert
                        
                        Swal.fire({
                            icon: 'info',
                            title: 'Confirmar venta con vuelto',
                            html: `
                                <div class="text-left">
                                    <p><strong>Pago recibido:</strong> ₡${totalPagos.toFixed(2)}</p>
                                    <p><strong>Total venta:</strong> ₡${totalVenta.toFixed(2)}</p>
                                    <p><strong>Vuelto a entregar:</strong> <span class="text-success">₡${vuelto.toFixed(2)}</span></p>
                                </div>
                            `,
                            showCancelButton: true,
                            confirmButtonText: 'Continuar con la venta',
                            cancelButtonText: 'Cancelar',
                            confirmButtonColor: '#28a745',
                            cancelButtonColor: '#6c757d'
                        }).then((result) => {
                            if (result.isConfirmed) {
                                // Remover este event listener temporalmente y reenviar el formulario
                                form.removeEventListener('submit', arguments.callee);
                                form.submit();
                            }
                        });
                        return false;
                    }
                });
            }
        });
    </script>
}