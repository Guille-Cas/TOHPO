<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - TOHPO</title>

    <!-- Bootstrap CSS local -->
    <link rel="stylesheet" href="~/lib/bootstrap/brite/bootstrap.min.css" />

    <!-- CSS de DataTables LOCAL -->
    <link rel="stylesheet" type="text/css" href="~/lib/datatables/css/datatables.min.css" asp-append-version="true" />

    <!-- Estilos propios -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/TOHPO.styles.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg bg-light" data-bs-theme="light">
            <div class="container">
                <a class="navbar-brand" asp-area="" asp-page="/Index">TOHPO</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse d-sm-inline-flex justify-content-between">
                    <ul class="navbar-nav flex-grow-1">
                        <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Index">Inicio</a>
                        </li>
@*                         <li class="nav-item">
                            <a class="nav-link text-dark" asp-area="" asp-page="/Privacy">Políticas de privacidad</a>
                        </li> *@
                    </ul>
                </div>
            </div>
        </nav>
    </header>

    <div class="container">
        <main role="main" class="pb-3">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2025 - TOHPO - <a asp-area="" asp-page="/Privacy">Privacy</a>
        </div>
    </footer>

    <!-- Scripts -->
    <!-- 1. jQuery LOCAL -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>

    <!-- 2. DataTables JS LOCAL -->
    <script type="text/javascript" src="~/lib/datatables/js/datatables.min.js" asp-append-version="true"></script>

    <!-- 3. Bootstrap JS -->
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.js"></script>

    <!-- 4. Scripts propios 
    <script src="~/js/site.js" asp-append-version="true"></script>-->

    <!-- Scripts específicos de la página (por ejemplo clientes.js) -->
    @await RenderSectionAsync("Scripts", required: false)
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/js/feedback-system.js"></script>
</body>
</html>
