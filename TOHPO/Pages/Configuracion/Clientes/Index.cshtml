@page
@model TOHPO.Pages.Configuracion.Clientes.IndexModel
@{
    ViewData["Title"] = "Gestión de Clientes";
}

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <!-- ENCABEZADO -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools d-flex gap-2">
                        <a asp-page="/Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                        <a asp-page="/Configuracion/Clientes/Upsert" class=" text-center btn btn-primary ">
                            <i class="bi bi-plus-circle"></i> Crear Cliente
                        </a>
                    </div>
                </div>


                <!-- CONTENIDO PRINCIPAL: TABLA -->
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tablaClientes" class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th class="text-center">Id</th>
                                    <th class="text-center">Identificación</th>
                                    <th class="text-center">Nombre completo</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de detalles del cliente -->
<div class="modal fade" id="detallesModal" tabindex="-1" aria-labelledby="detallesModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-success">
                <h5 class="modal-title" id="detallesModalLabel">Detalles del Cliente</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <ul class="list-group">
                    <li class="list-group-item"><strong>ID:</strong> <span id="modalId"></span></li>
                    <li class="list-group-item"><strong>Cédula:</strong> <span id="modalCedula"></span></li>
                    <li class="list-group-item"><strong>Nombre:</strong> <span id="modalNombre"></span></li>
                    <li class="list-group-item"><strong>Primer Apellido:</strong> <span id="modalPrimerApellido"></span></li>
                    <li class="list-group-item"><strong>Segundo Apellido:</strong> <span id="modalSegundoApellido"></span></li>
                    <li class="list-group-item"><strong>Correo:</strong> <span id="modalCorreo"></span></li>
                    <li class="list-group-item"><strong>Teléfono:</strong> <span id="modalTelefono"></span></li>
                </ul>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Configuracion/clientes.js" asp-append-version="true"></script>
}
