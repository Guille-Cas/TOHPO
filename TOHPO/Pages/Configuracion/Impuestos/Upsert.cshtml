@page "{id?}"
@using TOHPO.Models
@model TOHPO.Pages.Configuracion.Impuestos.UpsertModel
@{
    var isEdit = Model.Impuesto != null && Model.Impuesto.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Impuesto" : "Crear Impuesto";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <!-- ENCABEZADO -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools d-flex gap-2">
                        <a asp-page="/Configuracion/Impuestos/Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>

                <!-- DESCRIPCIÓN (ALERT) -->
                <div class="card-body border-bottom">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        @(isEdit
                                                ? "Actualice la información del impuesto y guarde los cambios para mantener sus datos al día."
                                                : "Complete la información del nuevo impuesto y guarde el registro para que quede disponible en el sistema.")

                    </div>
                </div>

                <!-- FORMULARIO -->
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Impuesto.Id" />
                        }

                        <div class="row g-3">
                            <div class="col-md-8">
                                <div class="mb-3">
                                    <label asp-for="Impuesto.Descripcion" class="form-label"></label>
                                    <input asp-for="Impuesto.Descripcion" class="form-control" />
                                    <span asp-validation-for="Impuesto.Descripcion" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-4">
                                <div class="mb-3">
                                    <label asp-for="Impuesto.Porcentaje" class="form-label"></label>
                                    <div class="input-group">
                                        <input asp-for="Impuesto.Porcentaje" class="form-control" />
                                        <span class="input-group-text">%</span>
                                    </div>
                                    <span asp-validation-for="Impuesto.Porcentaje" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="Impuesto.Estado" class="form-check-input" type="checkbox" />
                                <label asp-for="Impuesto.Estado" class="form-check-label">Activo</label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">
                                Guardar
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
