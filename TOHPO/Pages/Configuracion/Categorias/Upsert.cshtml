@page "{id?}"
@using TOHPO.Models
@model TOHPO.Pages.Configuracion.Categorias.UpsertModel
@{
    var isEdit = Model.Categoria != null;
}

<h2>@(isEdit ? "Editar Categoría" : "Crear Categoría")</h2>
<form method="post">
    @Html.AntiForgeryToken()
    @if (isEdit)
    {
        <input type="hidden" asp-for="Categoria.Id" />
    }
    <div class="mb-3">
        <label asp-for="Categoria.Descripcion" class="form-label"></label>
        <input asp-for="Categoria.Descripcion" class="form-control" />
        <span asp-validation-for="Categoria.Descripcion" class="text-danger"></span>
    </div>
    <button type="submit" class="btn btn-primary">Guardar</button>
    <a asp-page="/Configuracion/Categorias/Index" class="btn btn-secondary">Cancelar</a>
</form>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
