@page
@model TOHPO.Pages.Configuracion.Categorias.IndexModel
@{
    ViewData["Title"] = "Gestión de Categorías";
}

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <!-- ENCABEZADO -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools d-flex gap-2">
                        <a asp-page="/Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                        <a asp-page="/Configuracion/Categorias/Upsert" class="btn btn-primary text-center">
                            <i class="bi bi-plus-circle"></i> Crear Categoría
                        </a>
                    </div>
                </div>

                <!-- CONTENIDO PRINCIPAL: TABLA -->
                <div class="card-body">
                    <div class="table-responsive">
                        <table id="tablaCategorias" class="table table-striped table-bordered table-hover">
                            <thead class="table-dark">
                                <tr>
                                    <th class="text-center">Id</th>
                                    <th class="text-center">Descripción</th>
                                    <th class="text-center">Estado</th>
                                    <th class="text-center">Acciones</th>
                                </tr>
                            </thead>
                            <tbody></tbody>
                        </table>
                    </div>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Configuracion/categorias.js" asp-append-version="true"></script>
    <partial name="_TempDataFeedback" />
}
