@page "{id?}"
@using TOHPO.Models
@model TOHPO.Pages.Configuracion.Agentes_ventas.UpsertModel
@{
    var isEdit = Model.AgenteVentas != null && Model.AgenteVentas.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Agente de Ventas" : "Crear Agente de Ventas";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <!-- ENCABEZADO -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools d-flex gap-2">
                        <a asp-page="/Configuracion/Agentes_ventas/Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>

                <!-- DESCRIPCIÓN (ALERT) -->
                <div class="card-body border-bottom">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        @(isEdit
                                                ? "Actualice la información del agente de ventas y guarde los cambios para mantener sus datos al día."
                                                : "Complete la información del nuevo agente de ventas y guarde el registro para que quede disponible en el sistema.")
                    </div>
                </div>

                <!-- FORMULARIO PRINCIPAL -->
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="AgenteVentas.Id" />
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AgenteVentas.Nombre" class="form-label"></label>
                                    <input asp-for="AgenteVentas.Nombre" class="form-control" />
                                    <span asp-validation-for="AgenteVentas.Nombre" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AgenteVentas.Telefono" class="form-label"></label>
                                    <input asp-for="AgenteVentas.Telefono" class="form-control" />
                                    <span asp-validation-for="AgenteVentas.Telefono" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AgenteVentas.Correo_Electronico" class="form-label"></label>
                                    <input asp-for="AgenteVentas.Correo_Electronico" class="form-control" />
                                    <span asp-validation-for="AgenteVentas.Correo_Electronico" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AgenteVentas.Id_Proveedor" class="form-label"></label>
                                    <div class="input-group">
                                        <input type="text"
                                               id="proveedorDescripcion"
                                               class="form-control"
                                               value="@Model.ProveedorDescripcion"
                                               readonly />
                                        <button type="button"
                                                class="btn btn-info"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalProveedores">
                                            Buscar
                                        </button>
                                    </div>
                                    <span asp-validation-for="AgenteVentas.Id_Proveedor" class="text-danger"></span>
                                    <input type="hidden" asp-for="AgenteVentas.Id_Proveedor" />
                                </div>
                            </div>
                        </div>


                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">
                                Guardar
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de selección de proveedor -->
<div class="modal fade" id="modalProveedores" tabindex="-1" aria-labelledby="modalProveedoresLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">

            <div class="modal-header bg-success text-white">
                <h5 class="modal-title" id="modalProveedoresLabel">Seleccionar Proveedor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>

            <div class="modal-body">
                <table class="table table-bordered table-hover" id="tablaModalProveedores">
                    <thead class="table-dark">
                        <tr>
                            <th class="text-center">Id</th>
                            <th class="text-center">Nombre</th>
                            <th class="text-center">Teléfono</th>
                            <th class="text-center">Correo</th>
                            <th class="text-center">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var proveedor in Model.Proveedores)
                        {
                            <tr>
                                <td class="text-center">@proveedor.Id</td>
                                <td>@proveedor.Nombre</td>
                                <td>@proveedor.Telefono</td>
                                <td>@proveedor.Correo_Electronico</td>
                                <td class="text-center">
                                    <button type="button"
                                            class="btn btn-primary btn-sm btnSeleccionarProveedor"
                                            data-id="@proveedor.Id"
                                            data-nombre="@proveedor.Nombre"
                                            data-bs-dismiss="modal">
                                        Seleccionar
                                    </button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        $(document).ready(function () {
            $(document).on('click', '.btnSeleccionarProveedor', function () {
                var id = $(this).data('id');
                var nombre = $(this).data('nombre');
                $('input[name="AgenteVentas.Id_Proveedor"]').val(id);
                $('#proveedorDescripcion').val(nombre);
            });
        });
    </script>
}
