@page "{id?}"
@using TOHPO.Models
@model TOHPO.Pages.Configuracion.Agentes_ventas.UpsertModel
@{
    var isEdit = Model.AgenteVentas != null && Model.AgenteVentas.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Agente de Ventas" : "Crear Agente de Ventas";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <!-- ENCABEZADO -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools d-flex gap-2">
                        <a asp-page="/Configuracion/Agentes_ventas/Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>

                <!-- DESCRIPCIÓN (ALERT) -->
                <div class="card-body border-bottom">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        @(isEdit
                                                ? "Actualice la información del agente de ventas y guarde los cambios para mantener sus datos al día."
                                                : "Complete la información del nuevo agente de ventas y guarde el registro para que quede disponible en el sistema.")
                    </div>
                </div>

                <!-- FORMULARIO PRINCIPAL -->
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="AgenteVentas.Id" />
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AgenteVentas.Nombre" class="form-label"></label>
                                    <input asp-for="AgenteVentas.Nombre" class="form-control" />
                                    <span asp-validation-for="AgenteVentas.Nombre" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AgenteVentas.Telefono" class="form-label"></label>
                                    <input asp-for="AgenteVentas.Telefono" class="form-control" />
                                    <span asp-validation-for="AgenteVentas.Telefono" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="AgenteVentas.Correo_Electronico" class="form-label"></label>
                                    <input asp-for="AgenteVentas.Correo_Electronico" class="form-control" />
                                    <span asp-validation-for="AgenteVentas.Correo_Electronico" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label class="form-label">Proveedor</label>
                                    <div class="input-group">
                                        <input type="text"
                                               id="proveedorDescripcion"
                                               class="form-control"
                                               value="@Model.ProveedorDescripcion"
                                               readonly />
                                        <button type="button"
                                                class="btn btn-info"
                                                data-bs-toggle="modal"
                                                data-bs-target="#modalProveedores">
                                            Buscar
                                        </button>
                                    </div>
                                    <input type="hidden" asp-for="AgenteVentas.Id_Proveedor" />
                                </div>
                            </div>
                        </div>

                        <div class="mb-3">
                            <div class="form-check">
                                <input asp-for="AgenteVentas.Estado" class="form-check-input" type="checkbox" />
                                <label asp-for="AgenteVentas.Estado" class="form-check-label">Activo</label>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">
                                Guardar
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

<!-- Modal de selección de proveedores -->
<div class="modal fade" id="modalProveedores" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Seleccionar Proveedor</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="table-responsive">
                    <table class="table table-striped">
                        <thead>
                            <tr>
                                <th>Nombre</th>
                                <th>Teléfono</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var proveedor in Model.Proveedores)
                            {
                                <tr>
                                    <td>@proveedor.Nombre</td>
                                    <td>@proveedor.Telefono</td>
                                    <td>
                                        <button type="button" 
                                                class="btn btn-primary btn-sm"
                                                onclick="seleccionarProveedor(@proveedor.Id, '@proveedor.Nombre')">
                                            Seleccionar
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <partial name="~/Pages/Shared/_TempDataFeedback.cshtml" />
    <script>
        function seleccionarProveedor(id, nombre) {
            document.getElementById('AgenteVentas_Id_Proveedor').value = id;
            document.getElementById('proveedorDescripcion').value = nombre;
            
            // Cerrar el modal
            var modal = bootstrap.Modal.getInstance(document.getElementById('modalProveedores'));
            modal.hide();
        }
    </script>
}
