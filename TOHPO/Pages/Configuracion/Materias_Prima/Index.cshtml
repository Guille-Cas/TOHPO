@page
@model TOHPO.Pages.Configuracion.Materias_Prima.IndexModel
@{
}

<form method="post">
    @Html.AntiForgeryToken()
</form>

<div class="container mt-4">
    <h2>Gestión de Materias Primas</h2>
    <div class="mb-3">
        <a asp-page="/Index" class="btn btn-secondary">
            <i class="bi bi-arrow-left"></i> Regresar
        </a>
        <a asp-page="/Configuracion/Materias_Prima/Upsert" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Crear Materia Prima
        </a>
    </div>
    <table id="tablaMateriasPrima" class="table table-striped table-bordered">
        <thead>
            <tr>
                <th>Id</th>
                <th>Descripción</th>
                <th>Unidad de Medida</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody></tbody>
    </table>
</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/Configuracion/materias_prima.js" asp-append-version="true"></script>
}
