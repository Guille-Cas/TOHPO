@page "{id?}"
@using TOHPO.Models
@model TOHPO.Pages.Configuracion.Proveedores.UpsertModel
@{
    var isEdit = Model.Proveedor != null && Model.Proveedor.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Proveedor" : "Crear Proveedor";
}

<div class="container-fluid mt-4">
    <div class="row">
        <div class="col-12">
            <div class="card">

                <!-- ENCABEZADO -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools d-flex gap-2">
                        <a asp-page="/Configuracion/Proveedores/Index" class="btn btn-light">
                            <i class="bi bi-arrow-left"></i> Regresar
                        </a>
                    </div>
                </div>

                <!-- DESCRIPCIÓN (ALERT) -->
                <div class="card-body border-bottom">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        @(isEdit
                                                ? "Actualice la información del proveedor y guarde los cambios para mantener sus datos al día."
                                                : "Complete la información del nuevo proveedor y guarde el registro para que quede disponible en el sistema.")

                    </div>
                </div>

                <!-- FORMULARIO -->
                <div class="card-body">
                    <form method="post">
                        @Html.AntiForgeryToken()

                        @if (isEdit)
                        {
                            <input type="hidden" asp-for="Proveedor.Id" />
                        }

                        <div class="row g-3">
                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Proveedor.Nombre" class="form-label"></label>
                                    <input asp-for="Proveedor.Nombre" class="form-control" />
                                    <span asp-validation-for="Proveedor.Nombre" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Proveedor.Telefono" class="form-label"></label>
                                    <input asp-for="Proveedor.Telefono" class="form-control" />
                                    <span asp-validation-for="Proveedor.Telefono" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Proveedor.Correo_Electronico" class="form-label"></label>
                                    <input asp-for="Proveedor.Correo_Electronico" class="form-control" />
                                    <span asp-validation-for="Proveedor.Correo_Electronico" class="text-danger"></span>
                                </div>
                            </div>

                            <div class="col-md-6">
                                <div class="mb-3">
                                    <label asp-for="Proveedor.Direccion" class="form-label"></label>
                                    <input asp-for="Proveedor.Direccion" class="form-control" />
                                    <span asp-validation-for="Proveedor.Direccion" class="text-danger"></span>
                                </div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-3">
                            <button type="submit" class="btn btn-primary">
                                Guardar
                            </button>
                        </div>
                    </form>
                </div>

            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
