@page "{id:int?}"
@model TOHPO.Pages.Configuracion.Motivo_Recordatorio.UpsertModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.MotivoRecordatorio?.Id.ToString()) ? "Crear Motivo de Recordatorio" : "Editar Motivo de Recordatorio";
}

<div class="container-fluid">
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fas @(Model.MotivoRecordatorio?.Id == 0 ? "fa-plus" : "fa-edit") me-2"></i>
                        @ViewData["Title"]
                    </h3>
                    <div class="card-tools">
                        <a asp-page="./Index" class="btn btn-secondary btn-sm">
                            Volver al Listado
                        </a>
                    </div>
                </div>
                <form method="post">
                    <div class="card-body">
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>
                        
                        <input asp-for="MotivoRecordatorio.Id" hidden />

                        <div class="row">
                            <div class="col-md-8">
                                <div class="form-group mb-3">
                                    <label asp-for="MotivoRecordatorio.Descripcion" class="form-label"></label>
                                    <input asp-for="MotivoRecordatorio.Descripcion" class="form-control" />
                                    <span asp-validation-for="MotivoRecordatorio.Descripcion" class="text-danger"></span>
                                </div>
                            </div>
                            
                            <div class="col-md-4">
                                <div class="form-group mb-3">
                                    <div class="form-check mt-4">
                                        <input asp-for="MotivoRecordatorio.Estado" class="form-check-input" type="checkbox" />
                                        <label asp-for="MotivoRecordatorio.Estado" class="form-check-label">Activo</label>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    
                    <div class="card-footer">
                        <div class="row">
                            <div class="col-md-12">
                                <button type="submit" class="btn btn-success">
                                    @(Model.MotivoRecordatorio?.Id == 0 ? "Crear" : "Actualizar")
                                </button>
                                <a asp-page="./Index" class="btn btn-secondary ms-2">
                                    Cancelar
                                </a>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}