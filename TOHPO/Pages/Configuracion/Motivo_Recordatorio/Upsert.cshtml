@page "{id:int?}"
@model TOHPO.Pages.Configuracion.Motivo_Recordatorio.UpsertModel
@{
    var isEdit = Model.MotivoRecordatorio != null && Model.MotivoRecordatorio.Id > 0;
    ViewData["Title"] = isEdit ? "Editar Motivo de Recordatorio" : "Crear Motivo de Recordatorio";
}

<div class="container-fluid mt-4">
    <div class="row justify-content-center">
        <div class="col-12">
            <div class="card">
                <!-- ENCABEZADO -->
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h3 class="card-title mb-0">
                        @ViewData["Title"]
                    </h3>
                    <a asp-page="./Index" class="btn btn-light">
                        <i class="bi bi-arrow-left"></i> Regresar
                    </a>
                </div>

                <!-- DESCRIPCIÓN (ALERT) -->
                <div class="card-body border-bottom">
                    <div class="alert alert-warning alert-dismissible fade show" role="alert">
                        @(isEdit
                                                ? "Actualice la información del motivo de recordatorio y guarde los cambios para mantener sus datos al día."
                                                : "Complete la información del nuevo motivo de recordatorio y guarde el registro para que quede disponible en el sistema.")

                    </div>
                </div>
                <!-- CONTENIDO -->
                <div class="card-body">
                    <form method="post">
                        <!-- ID oculto -->
                        <input asp-for="MotivoRecordatorio.Id" type="hidden" />

                        <!-- Descripción -->
                        <div class="mb-3">
                            <label asp-for="MotivoRecordatorio.Descripcion" class="form-label"></label>
                            <input asp-for="MotivoRecordatorio.Descripcion" class="form-control"/>
                            <span asp-validation-for="MotivoRecordatorio.Descripcion" class="text-danger"></span>
                        </div>

                        <!-- Botones -->
                        <div class="d-flex gap-2 justify-content-end">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-circle"></i>
                                Guardar
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}