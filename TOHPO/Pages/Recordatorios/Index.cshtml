@page
@model TOHPO.Pages.Recordatorios.IndexModel
@{
    ViewData["Title"] = "Recordatorios";
}

<div class="container-fluid">
    @Html.AntiForgeryToken()
    
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>@ViewData["Title"]</h2>
        <div>
            <a asp-page="./Upsert" class="btn btn-primary">
                Nuevo Recordatorio
            </a>
            <button type="button" class="btn btn-outline-secondary" id="toggleView">
                Vista Calendario
            </button>
        </div>
    </div>

    <!-- Filtros rápidos -->
    <div class="row mb-3">
        <div class="col-12">
            <div class="btn-group" role="group" aria-label="Filtros de estado">
                <button type="button" class="btn btn-outline-primary active" data-filtro="todos">
                    Todos
                </button>
                <button type="button" class="btn btn-outline-danger" data-filtro="Vencido">
                    Vencidos
                </button>
                <button type="button" class="btn btn-outline-warning" data-filtro="Próximo">
                    Próximos
                </button>
                <button type="button" class="btn btn-outline-success" data-filtro="Programado">
                    Programados
                </button>
                <button type="button" class="btn btn-outline-info" data-filtro="recurrente">
                    Recurrentes
                </button>
            </div>
        </div>
    </div>

    <!-- Vista Lista -->
    <div id="vistaLista" class="card">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5>Lista de Recordatorios</h5>
            <button type="button" class="btn btn-sm btn-outline-primary" onclick="cargarRecordatorios()">
                Actualizar
            </button>
        </div>
        <div class="card-body">
            <div class="table-responsive">
                <table class="table table-striped table-hover table-bordered" id="tablaRecordatorios">
                    <thead class="table-white">
                        <tr>
                            <th>Fecha/Hora</th>
                            <th>Cliente</th>
                            <th>Motivo</th>
                            <th>Detalles</th>
                            <th>Recurrencia</th>
                            <th>Estado</th>
                            <th>Acciones</th>
                        </tr>
                    </thead>
                    <tbody></tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Vista Calendario -->
    <div id="vistaCalendario" class="card" style="display: none;">
        <div class="card-header d-flex justify-content-between align-items-center">
            <h5> Calendario de Recordatorios</h5>
        </div>
        <div class="card-body">
            <div id="calendario"></div>
        </div>
    </div>
</div>

<!-- Modal Detalles -->
<div class="modal fade" id="modalDetalles" tabindex="-1">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">
                     Detalles del Recordatorio
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body" id="contenidoModalDetalles">
                <!-- Contenido dinámico -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                     Cerrar
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <link href="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/index.global.min.css" rel="stylesheet" />
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/index.global.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/fullcalendar@6.1.9/locales/es.global.min.js"></script>
    <script src="~/js/Recordatorios/recordatorios.js" asp-append-version="true"></script>
}